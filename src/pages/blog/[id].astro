---
import { getCollection, render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import Analytics from '../../components/Analytics.astro';
import AnalyticsNoscript from '../../components/AnalyticsNoscript.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Posts relacionados reais (exclui o atual, mais recentes primeiro)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3);

// Dados de compartilhamento (gerados no build, sem depender de JS)
const shareUrl = `https://www.filomenapropaganda.com.br/blog/${post.id}/`;
const shareTitle = post.data.title;
const enc = encodeURIComponent;
const share = {
  whatsapp: `https://api.whatsapp.com/send?text=${enc(`${shareTitle} ${shareUrl}`)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${enc(shareUrl)}`,
  x: `https://twitter.com/intent/tweet?text=${enc(shareTitle)}&url=${enc(shareUrl)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(shareUrl)}`,
  telegram: `https://t.me/share/url?url=${enc(shareUrl)}&text=${enc(shareTitle)}`,
  email: `mailto:?subject=${enc(shareTitle)}&body=${enc(`${shareTitle}\n\n${shareUrl}`)}`,
};
---
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <Analytics />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={post.data.description}>
    <title>{post.data.title} | Filomena Propaganda</title>
    <link rel="canonical" href={`https://www.filomenapropaganda.com.br/blog/${post.id}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${post.data.title} | Filomena Propaganda`} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={`https://www.filomenapropaganda.com.br/blog/${post.id}/`} />
    <meta property="og:image" content={`https://www.filomenapropaganda.com.br${post.data.thumbnail}`} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`https://www.filomenapropaganda.com.br${post.data.thumbnail}`} />
    <link rel="preload" href="/assets/fonts/OliviarSans-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/styles.css">

    <style>
        /* =========================================
           BLOG POST PAGE - PREMIUM DESIGN
        ========================================= */

        .post-header {
            padding: 8rem 0 4rem;
            text-align: center;
        }

        .post-tag {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--primary);
            margin-bottom: 1.5rem;
            display: inline-block;
        }

        .post-title {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 2rem;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
            color: var(--text);
        }

        .post-meta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            font-size: 0.95rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .post-meta__divider {
            color: var(--border);
        }

        .post-author {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .post-author__avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
        }

        /* Hero Image */
        .post-hero-image {
            max-width: 1000px;
            margin: 0 auto 5rem;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        .post-hero-image img {
            width: 100%;
            height: 60vh;
            object-fit: cover;
            display: block;
            background: var(--bg-alt);
        }

        /* Content Area */
        .post-content {
            max-width: 760px;
            margin: 0 auto;
            font-size: 1.15rem;
            line-height: 1.9;
            color: var(--text);
            padding-bottom: 6rem;
        }

        .post-content :global(p) {
            margin-bottom: 1.8rem;
            line-height: 1.9;
        }

        .post-content :global(h2) {
            font-family: var(--font-heading);
            font-size: 2.2rem;
            font-weight: 800;
            margin: 4rem 0 1.5rem;
            line-height: 1.2;
            color: var(--text);
        }

        .post-content :global(h3) {
            font-family: var(--font-heading);
            font-size: 1.6rem;
            font-weight: 700;
            margin: 3rem 0 1.2rem;
            line-height: 1.3;
            color: var(--text);
        }

        .post-content :global(h4) {
            font-family: var(--font-heading);
            font-size: 1.3rem;
            font-weight: 700;
            margin: 2.5rem 0 1rem;
            line-height: 1.3;
            color: var(--text);
        }

        .post-content :global(strong) {
            font-weight: 700;
            color: var(--text);
        }

        .post-content :global(a) {
            color: var(--primary);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .post-content :global(blockquote) {
            margin: 3rem 0;
            padding: 2.5rem;
            border-left: 6px solid var(--primary);
            background: var(--bg-alt);
            border-radius: 0 16px 16px 0;
            font-size: 1.3rem;
            font-style: italic;
            font-weight: 600;
            line-height: 1.6;
            color: var(--text);
        }

        .post-content :global(ul),
        .post-content :global(ol) {
            margin: 0 0 1.8rem;
            padding-left: 1.5rem;
        }

        .post-content :global(li) {
            margin-bottom: 0.85rem;
            line-height: 1.8;
        }

        .post-content :global(img) {
            width: 100%;
            border-radius: 12px;
            margin: 3rem 0;
        }

        .post-content :global(hr) {
            border: none;
            border-top: 1px solid var(--border);
            margin: 3.5rem 0;
        }

        /* Share & Back */
        .post-footer {
            max-width: 760px;
            margin: 0 auto 6rem;
            padding-top: 3rem;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1.5rem 2rem;
        }

        .share-links {
            display: flex;
            gap: 0.6rem;
            align-items: center;
            flex-wrap: wrap;
            position: relative;
        }

        .share-links__label {
            font-weight: 600;
            font-size: 0.9rem;
            margin-right: 0.25rem;
        }

        .share-btn {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text);
            cursor: pointer;
            padding: 0;
            transition: transform 0.2s ease, background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
        }

        /* O compartilhamento nativo (mais opções) só faz sentido no celular */
        @media (min-width: 769px) {
            .share-btn--native { display: none !important; }
        }

        .share-btn:hover {
            transform: translateY(-3px);
            color: white;
            border-color: transparent;
        }

        /* Cores de cada marca no hover */
        .share-btn--whatsapp:hover { background: #25D366; }
        .share-btn--facebook:hover { background: #1877F2; }
        .share-btn--x:hover         { background: #000000; }
        .share-btn--linkedin:hover  { background: #0A66C2; }
        .share-btn--telegram:hover  { background: #229ED9; }
        .share-btn--instagram:hover { background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); }
        .share-btn--email:hover     { background: var(--secondary); }
        .share-btn--copy:hover      { background: var(--primary); }
        .share-btn--native:hover    { background: var(--primary); }

        .share-btn--copy.is-copied {
            background: #25a05a;
            border-color: transparent;
            color: white;
        }

        /* Toast "Link copiado!" */
        .share-toast {
            position: absolute;
            bottom: calc(100% + 10px);
            right: 0;
            background: var(--text);
            color: var(--bg);
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.5rem 0.85rem;
            border-radius: 8px;
            white-space: nowrap;
            opacity: 0;
            transform: translateY(6px);
            pointer-events: none;
            transition: opacity 0.25s ease, transform 0.25s ease;
        }

        .share-toast.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 968px) {
            .share-links { justify-content: flex-start; }
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .back-link:hover {
            color: var(--primary);
        }

        /* Recommended Posts */
        .recommended {
            background: var(--bg-alt);
            padding: 6rem 0;
        }

        .recommended__header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 3rem;
        }

        .recommended__title {
            font-size: 2.5rem;
            font-weight: 800;
        }

        .blog-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-xl);
        }

        .blog-card {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            overflow: hidden;
            transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
        }
        .blog-card:hover {
            border-color: var(--accent);
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
        }
        .blog-card__img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background: var(--bg-alt);
            display: block;
        }
        .blog-card__body { padding: var(--space-xl); }
        .blog-card__tag {
            font-size: var(--text-xs);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--accent);
            margin-bottom: var(--space-sm);
            display: block;
        }
        .blog-card__title {
            font-family: var(--font-heading);
            font-weight: 700;
            margin-bottom: var(--space-md);
            line-height: 1.3;
            color: var(--text);
        }
        .blog-card__excerpt {
            font-size: var(--text-sm);
            color: var(--text-muted);
            margin-bottom: var(--space-lg);
            line-height: 1.6;
        }
        .blog-card__link {
            display: inline-flex;
            align-items: center;
            gap: var(--space-xs);
            font-size: var(--text-sm);
            font-weight: 600;
            color: var(--accent);
        }

        @media (max-width: 968px) {
            .blog-grid { grid-template-columns: repeat(2, 1fr); }
            .post-hero-image img { height: 40vh; }
            .post-footer { flex-direction: column; gap: 2rem; align-items: flex-start; }
        }
        @media (max-width: 576px) {
            .blog-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>
    <AnalyticsNoscript />
    <div class="noise-overlay"></div>
    
    <!-- Header -->
    <header class="header">
        <div class="header__inner container">
            <a href="/" class="logo">
                <img src="/assets/images/logo-main.webp" alt="Filomena Propaganda & Marketing" class="logo__img">
            </a>

            <nav class="nav">
                <ul class="nav__list" id="nav-menu">
                    <li><a href="/" class="nav__link">Home</a></li>
                    <li><a href="/sobre/" class="nav__link">Sobre</a></li>
                    <li><a href="/servicos/" class="nav__link">Serviços</a></li>
                    <li><a href="/portfolio/" class="nav__link">Portfólio</a></li>
                    <li><a href="/blog/" class="nav__link active">Blog</a></li>
                    <li><a href="/trabalhe-conosco/" class="nav__link">Trabalhe Conosco</a></li>
                    <li><a href="/contato/" class="nav__link">Contato</a></li>
                </ul>

                <div class="nav__actions">
                    <button class="menu-toggle" id="menu-toggle" aria-label="Menu">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <!-- POST HEADER -->
        <article>
            <header class="post-header container">
                <span class="post-tag fade-in">{post.data.category}</span>
                <h1 class="post-title fade-in">{post.data.title}</h1>
                <div class="post-meta fade-in">
                    <div class="post-author">
                        <div class="post-author__avatar">{post.data.author.charAt(0)}</div>
                        <span>{post.data.author}</span>
                    </div>
                    <span class="post-meta__divider">•</span>
                    <span>{new Date(post.data.date).toLocaleDateString('pt-BR')}</span>
                    <span class="post-meta__divider">•</span>
                    <span>Leitura rápida</span>
                </div>
            </header>

            <div class="post-hero-image container fade-in">
                {post.data.thumbnail && <img loading="lazy" decoding="async" src={post.data.thumbnail} alt={post.data.title}>}
            </div>

            <!-- POST CONTENT -->
            <div class="post-content fade-in container">
                <Content />
            </div>

            <!-- POST FOOTER / SHARE -->
            <div class="post-footer container fade-in">
                <a href="/blog/" class="back-link">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
                    Voltar para o blog
                </a>

                <div class="share-links" id="post-share" data-share-url={shareUrl} data-share-title={shareTitle}>
                    <span class="share-links__label">Compartilhar:</span>

                    <!-- WhatsApp -->
                    <a href={share.whatsapp} target="_blank" rel="noopener" class="share-btn share-btn--whatsapp" aria-label="Compartilhar no WhatsApp">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    </a>

                    <!-- Facebook -->
                    <a href={share.facebook} target="_blank" rel="noopener" class="share-btn share-btn--facebook" aria-label="Compartilhar no Facebook">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>

                    <!-- X (Twitter) -->
                    <a href={share.x} target="_blank" rel="noopener" class="share-btn share-btn--x" aria-label="Compartilhar no X">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>

                    <!-- LinkedIn -->
                    <a href={share.linkedin} target="_blank" rel="noopener" class="share-btn share-btn--linkedin" aria-label="Compartilhar no LinkedIn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>

                    <!-- Telegram -->
                    <a href={share.telegram} target="_blank" rel="noopener" class="share-btn share-btn--telegram" aria-label="Compartilhar no Telegram">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                    </a>

                    <!-- Instagram (usa o compartilhamento nativo do celular para Stories/Direct) -->
                    <button type="button" class="share-btn share-btn--instagram" data-share-instagram aria-label="Compartilhar no Instagram">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </button>

                    <!-- E-mail -->
                    <a href={share.email} class="share-btn share-btn--email" aria-label="Compartilhar por e-mail">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </a>

                    <!-- Copiar link -->
                    <button type="button" class="share-btn share-btn--copy" data-share-copy aria-label="Copiar link">
                        <svg class="icon-copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        <svg class="icon-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </button>

                    <!-- Mais opções (compartilhamento nativo — só aparece em aparelhos compatíveis) -->
                    <button type="button" class="share-btn share-btn--native" data-share-native aria-label="Mais opções de compartilhamento" hidden>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                    </button>

                    <span class="share-toast" data-share-toast role="status" aria-live="polite"></span>
                </div>
            </div>
        </article>

        <!-- RECOMMENDED POSTS -->
        {relatedPosts.length > 0 && (
        <section class="recommended">
            <div class="container">
                <div class="recommended__header fade-in">
                    <h2 class="recommended__title">Leia também</h2>
                    <a href="/blog/" class="btn btn--outline">Ver todos os artigos</a>
                </div>

                <div class="blog-grid">
                    {relatedPosts.map((p) => (
                        <article class="blog-card fade-in">
                            <a href={`/blog/${p.id}/`} aria-label={p.data.title}>
                                <img loading="lazy" decoding="async" class="blog-card__img" src={p.data.thumbnail || "/assets/images/fachada-filomena.webp"} alt={p.data.title}>
                            </a>
                            <div class="blog-card__body">
                                <span class="blog-card__tag">{p.data.category}</span>
                                <h3 class="blog-card__title" style="font-size: 1.25rem;">{p.data.title}</h3>
                                <p class="blog-card__excerpt">{p.data.description}</p>
                                <a href={`/blog/${p.id}/`} class="blog-card__link">
                                    Ler artigo
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
                                </a>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>
        )}
    </main>

    <!-- Footer -->
    <Footer />

    <a href="https://api.whatsapp.com/send?l=pt_BR&phone=551634154110&text=Ol%C3%A1!%20Estou%20visitando%20o%20site%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es." class="whatsapp-btn" target="_blank" aria-label="WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </a>

    <script src="/script.js" is:inline></script>

    <!-- Compartilhamento do artigo -->
    <script is:inline>
      function initPostShare() {
        const box = document.getElementById('post-share');
        if (!box || box.dataset.shareReady) return;
        box.dataset.shareReady = 'true';

        const url = box.dataset.shareUrl || window.location.href;
        const title = box.dataset.shareTitle || document.title;
        const toast = box.querySelector('[data-share-toast]');
        let toastTimer;

        function showToast(message) {
          if (!toast) return;
          toast.textContent = message;
          toast.classList.add('is-visible');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () {
            toast.classList.remove('is-visible');
          }, 2600);
        }

        async function copyLink() {
          try {
            await navigator.clipboard.writeText(url);
          } catch (e) {
            // Fallback para navegadores sem Clipboard API
            const tmp = document.createElement('textarea');
            tmp.value = url;
            tmp.style.position = 'fixed';
            tmp.style.opacity = '0';
            document.body.appendChild(tmp);
            tmp.select();
            try { document.execCommand('copy'); } catch (err) {}
            document.body.removeChild(tmp);
          }
        }

        const canNativeShare = typeof navigator.share === 'function';

        async function nativeShare() {
          try {
            await navigator.share({ title: title, text: title, url: url });
            return true;
          } catch (e) {
            return false; // usuário cancelou ou não suportado
          }
        }

        // Botão "mais opções" (compartilhamento nativo): só mostra se houver suporte
        const nativeBtn = box.querySelector('[data-share-native]');
        if (nativeBtn && canNativeShare) {
          nativeBtn.hidden = false;
          nativeBtn.addEventListener('click', nativeShare);
        }

        // Instagram: não há link web para Stories/Direct.
        // No celular, abre a folha nativa (onde aparece o Instagram).
        // No desktop, copia o link e orienta a colar no Story/Direct.
        const igBtn = box.querySelector('[data-share-instagram]');
        if (igBtn) {
          igBtn.addEventListener('click', async function () {
            if (canNativeShare) {
              const ok = await nativeShare();
              if (ok) return;
            }
            await copyLink();
            showToast('Link copiado! Cole no seu story ou direct do Instagram.');
          });
        }

        // Copiar link
        const copyBtn = box.querySelector('[data-share-copy]');
        if (copyBtn) {
          const iconCopy = copyBtn.querySelector('.icon-copy');
          const iconCheck = copyBtn.querySelector('.icon-check');
          copyBtn.addEventListener('click', async function () {
            await copyLink();
            copyBtn.classList.add('is-copied');
            if (iconCopy) iconCopy.style.display = 'none';
            if (iconCheck) iconCheck.style.display = 'block';
            showToast('Link copiado!');
            setTimeout(function () {
              copyBtn.classList.remove('is-copied');
              if (iconCopy) iconCopy.style.display = 'block';
              if (iconCheck) iconCheck.style.display = 'none';
            }, 2200);
          });
        }
      }

      // Funciona no carregamento normal e nas transições do ClientRouter
      document.addEventListener('astro:page-load', initPostShare);
      if (document.readyState !== 'loading') initPostShare();
      else document.addEventListener('DOMContentLoaded', initPostShare);
    </script>
