---
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import AnalyticsNoscript from '../components/AnalyticsNoscript.astro';
---
<!DOCTYPE html>
<html lang="en">

<head>
    <Analytics />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Privacy Policy | Filomena Propaganda</title>
    <meta name="description" content="Read the Privacy Policy of Filomena Propaganda. Learn how we collect, process, and protect your personal data in compliance with Brazilian LGPD and global privacy standards.">

    <link rel="canonical" href="https://www.filomenapropaganda.com.br/privacy/" />
    <link rel="alternate" type="text/markdown" href="/privacy.md" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Privacy Policy | Filomena Propaganda" />
    <meta property="og:description" content="Learn how Filomena Propaganda respects and protects your personal data and privacy." />
    <meta property="og:url" content="https://www.filomenapropaganda.com.br/privacy/" />
    <meta property="og:site_name" content="Filomena Propaganda" />
    <meta property="og:image" content="https://www.filomenapropaganda.com.br/assets/images/og-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Privacy Policy | Filomena Propaganda" />
    <meta name="twitter:description" content="Data privacy standards and compliance overview from Filomena Propaganda." />
    <meta name="twitter:image" content="https://www.filomenapropaganda.com.br/assets/images/og-preview.png" />

    <!-- GEO / Local SEO -->
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="São Carlos" />
    <meta name="geo.position" content="-22.008978;-47.887784" />
    <meta name="ICBM" content="-22.008978, -47.887784" />
    <meta name="robots" content="index, follow" />

    <!-- Organization Schema -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "AdvertisingAgency", "LocalBusiness"],
      "name": "Filomena Propaganda",
      "legalName": "Filomena Propaganda e Marketing Ltda",
      "image": "https://www.filomenapropaganda.com.br/assets/images/fachada-filomena.webp",
      "logo": "https://www.filomenapropaganda.com.br/assets/images/logo-main.webp",
      "@id": "https://www.filomenapropaganda.com.br/#organization",
      "url": "https://www.filomenapropaganda.com.br",
      "telephone": "+551634154110",
      "email": "contato@filomenapropaganda.com.br",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Dom Pedro II, 1978",
        "addressLocality": "São Carlos",
        "addressRegion": "SP",
        "postalCode": "13560-235",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -22.0089776,
        "longitude": -47.8877838
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ],
        "opens": "08:00",
        "closes": "18:00"
      },
      "sameAs": [
        "https://www.instagram.com/filomenaagencia/",
        "https://www.facebook.com/filomenaagencia",
        "https://www.linkedin.com/company/filomenaagencia/",
        "https://www.behance.net/filomenapropaganda"
      ],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+551634154110",
          "email": "contato@filomenapropaganda.com.br",
          "contactType": "customer service",
          "areaServed": "BR",
          "availableLanguage": ["Portuguese", "English", "pt-BR"]
        },
        {
          "@type": "ContactPoint",
          "telephone": "+551634154110",
          "email": "contato@filomenapropaganda.com.br",
          "contactType": "sales",
          "areaServed": "BR",
          "availableLanguage": ["Portuguese", "English", "pt-BR"]
        }
      ]
    }
    </script>
    <link rel="preload" href="/assets/fonts/OliviarSans-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .privacy-content {
            max-width: 800px;
            margin: 0 auto;
            color: var(--text-body, #e2e8f0);
            line-height: 1.8;
            font-size: 1.05rem;
        }
        .privacy-content h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
            margin-top: 2.5rem;
            margin-bottom: 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 0.5rem;
        }
        .privacy-content h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--secondary, #8053ff);
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
        }
        .privacy-content p {
            margin-bottom: 1.25rem;
        }
        .privacy-content ul {
            margin-bottom: 1.5rem;
            padding-left: 1.5rem;
        }
        .privacy-content li {
            margin-bottom: 0.5rem;
        }
        .privacy-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 1.5rem;
            margin: 1.5rem 0;
        }
    </style>
</head>

<body>
    <AnalyticsNoscript />
    <div class="noise-overlay"></div>
    <header class="header">
        <div class="header__inner container">
            <a href="/" class="logo">
                <img src="/assets/images/logo-main.webp" alt="Filomena Propaganda & Marketing" class="logo__img" width="220" height="50" loading="eager" />
            </a>
            <nav class="nav">
                <ul class="nav__list" id="nav-menu">
                    <li><a href="/" class="nav__link">Home</a></li>
                    <li><a href="/sobre/" class="nav__link">Sobre</a></li>
                    <li><a href="/servicos/" class="nav__link">Serviços</a></li>
                    <li><a href="/portfolio/" class="nav__link">Portfólio</a></li>
                    <li><a href="/blog/" class="nav__link">Blog</a></li>
                    <li><a href="/trabalhe-conosco/" class="nav__link">Trabalhe Conosco</a></li>
                    <li><a href="/contato/" class="nav__link">Contato</a></li>
                </ul>
                <div class="nav__actions">
                    <button class="menu-toggle" id="menu-toggle" aria-label="Menu">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main id="main-content">
        <section class="section" style="padding-top: calc(var(--header-height, 80px) + 3rem); padding-bottom: 5rem;">
            <div class="container">
                <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem;">
                    <span class="badge" style="display: inline-block; margin-bottom: 1rem; padding: 0.35rem 1rem; border-radius: 999px; background: rgba(128,83,255,0.1); border: 1px solid rgba(128,83,255,0.25); color: var(--secondary); font-size: 0.85rem; font-weight: 600;">PRIVACY & DATA PROTECTION</span>
                    <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; line-height: 1.2; margin-bottom: 1rem;">
                        Privacy Policy
                    </h1>
                    <p style="color: var(--text-muted); font-size: 1.05rem;">
                        Last updated: September 2026. In full compliance with Brazilian LGPD (Lei nº 13.709/2018) and international privacy frameworks.
                    </p>
                </div>

                <div class="privacy-content">
                    <div class="privacy-card">
                        <strong style="color: #fff; display: block; margin-bottom: 0.5rem;">Our Privacy Commitment</strong>
                        <p style="margin: 0; font-size: 0.95rem; color: var(--text-muted);">
                            Filomena Propaganda e Marketing Ltda is dedicated to safeguarding the personal data, confidentiality, and fundamental privacy rights of all clients, prospects, applicants, and website visitors.
                        </p>
                    </div>

                    <h2>1. Data Controller Identification</h2>
                    <p>
                        The legal entity responsible for personal data processing under this website is <strong>Filomena Propaganda e Marketing Ltda</strong>:
                    </p>
                    <ul>
                        <li><strong>Headquarters Address:</strong> Rua Dom Pedro II, 1978, São Carlos - SP, 13560-235, Brazil</li>
                        <li><strong>Direct Phone:</strong> +55 (16) 3415-4110</li>
                        <li><strong>Corporate Email:</strong> contato@filomenapropaganda.com.br</li>
                        <li><strong>Data Protection Officer (DPO):</strong> dpo@filomenapropaganda.com.br</li>
                    </ul>

                    <h2>2. Information We Collect and Purposes</h2>
                    <p>
                        We collect only minimal and relevant personal data strictly necessary to answer inquiries and deliver professional marketing solutions:
                    </p>
                    
                    <h3>2.1 Data provided directly by you</h3>
                    <ul>
                        <li><strong>Contact and Quote Inquiries:</strong> Full Name, corporate email address, telephone/WhatsApp number, organization name, and project scope details. <em>Purpose:</em> To respond to commercial requests, draft service proposals, and manage customer relations.</li>
                        <li><strong>Career Applications:</strong> Name, contact details, curriculum vitae, and portfolio links. <em>Purpose:</em> Evaluating candidates for open positions within our agency.</li>
                    </ul>

                    <h3>2.2 Automated navigation data and cookies</h3>
                    <ul>
                        <li><strong>Site Usage Analytics:</strong> Anonymized IP addresses, browser types, operating systems, page interaction duration, and referral URLs via Google Analytics and Google Tag Manager. <em>Purpose:</em> Statistical website performance analysis and information security.</li>
                    </ul>

                    <h2>3. Legal Bases for Processing</h2>
                    <p>
                        All processing activities conducted by Filomena Propaganda are grounded in legitimate legal bases:
                    </p>
                    <ul>
                        <li><strong>Explicit Consent:</strong> Provided when you voluntarily submit contact forms or accept website cookies.</li>
                        <li><strong>Pre-Contractual Steps:</strong> Preparing service quotes and technical specifications at your direct request.</li>
                        <li><strong>Legitimate Interests:</strong> Protecting platform integrity, cybersecurity, and improving service quality.</li>
                    </ul>

                    <h2>4. Data Sharing and Protection</h2>
                    <p>
                        We do not sell, rent, or lease personal information to any third parties for marketing purposes. Data is accessed solely by authorized agency personnel and reputable infrastructure service providers bound by strict confidentiality obligations. All web transmissions are encrypted via industry-standard TLS/HTTPS protocols.
                    </p>

                    <h2>5. Your Rights as a Data Subject</h2>
                    <p>
                        In accordance with statutory data protection regulations, you have the right to:
                    </p>
                    <ul>
                        <li>Confirm the existence of personal data processing;</li>
                        <li>Access your personal data records held by us;</li>
                        <li>Request correction of inaccurate, outdated, or incomplete data;</li>
                        <li>Request deletion or anonymization of unnecessary data;</li>
                        <li>Withdraw previously granted consent at any time.</li>
                    </ul>
                    <p>
                        To submit a data subject rights request, please email our team at: <a href="mailto:contato@filomenapropaganda.com.br" style="color: var(--secondary); text-decoration: underline;">contato@filomenapropaganda.com.br</a>.
                    </p>

                    <h2>6. Contact & Policy Updates</h2>
                    <p>
                        This Privacy Policy is subject to routine reviews. Any updates will be published directly on this page. For any questions or privacy inquiries, contact us directly through our official channels.
                    </p>
                </div>
            </div>
        </section>
    </main>

    <Footer />
    <script src="/script.js" is:inline></script>
</body>
</html>
