---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
const projects = await getCollection('portfolio');
---
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nosso Portfólio | Cases de Sucesso | Filomena Propaganda</title>
    <meta name="description" content="Explore os cases de sucesso e projetos de publicidade, design e tráfego pago desenvolvidos pela Filomena Propaganda para clientes de todo o Brasil.">

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Portfólio | Filomena Propaganda" />
    <meta property="og:description" content="Conheça os projetos criativos e estratégicos criados para marcas e empresas que voam alto." />
    <meta property="og:url" content="https://www.filomenapropaganda.com.br/portfolio" />
    <meta property="og:site_name" content="Filomena Propaganda" />
    <meta property="og:image" content="https://www.filomenapropaganda.com.br/assets/images/fachada-filomena.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Nosso Portfólio | Cases de Sucesso | Filomena Propaganda" />
    <meta name="twitter:description" content="Explore os cases de sucesso e projetos de publicidade, design e tráfego pago desenvolvidos pela Filomena Propaganda para clientes de todo o Brasil." />
    <meta name="twitter:image" content="https://www.filomenapropaganda.com.br/assets/images/fachada-filomena.png" />

    <!-- GEO Geotagging / Local SEO -->
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="São Carlos" />
    <meta name="geo.position" content="-22.008978;-47.887784" />
    <meta name="ICBM" content="-22.008978, -47.887784" />
    <meta name="robots" content="index, follow" />

    <!-- JSON-LD LocalBusiness Structured Data -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "AdvertisingAgency",
      "name": "Filomena Propaganda",
      "image": "https://www.filomenapropaganda.com.br/assets/images/fachada-filomena.png",
      "@id": "https://www.filomenapropaganda.com.br",
      "url": "https://www.filomenapropaganda.com.br",
      "telephone": "+551634154110",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Dom Pedro II, 1978",
        "addressLocality": "São Carlos",
        "addressRegion": "SP",
        "postalCode": "13560-235",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -22.0089776,
        "longitude": -47.8877838
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ],
        "opens": "08:00",
        "closes": "18:00"
      },
      "sameAs": [
        "https://www.instagram.com/filomenapropaganda/",
        "https://www.facebook.com/filomenapropaganda",
        "https://www.linkedin.com/company/filomena-propaganda/",
        "https://www.behance.net/filomenapropaganda"
      ]
    }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/styles.css">
    
</head>

<body>
    <div class="noise-overlay"></div>
    <!-- Header -->
    <header class="header">
        <div class="header__inner container">
            <a href="/" class="logo">
                <img src="/assets/images/logo-main.png" alt="Filomena Propaganda & Marketing" class="logo__img">
            </a>

            <nav class="nav">
                <ul class="nav__list" id="nav-menu">
                    <li><a href="/" class="nav__link">Home</a></li>
                    <li><a href="sobre" class="nav__link">Sobre</a></li>
                    <li><a href="servicos" class="nav__link">Serviços</a></li>
                    <li><a href="portfolio" class="nav__link">Portfólio</a></li>
                    <li><a href="blog" class="nav__link">Blog</a></li>
                    <li><a href="trabalhe-conosco" class="nav__link">Trabalhe Conosco</a></li>
                    <li><a href="contato" class="nav__link">Contato</a></li>
                </ul>

                <div class="nav__actions">
                    <button class="menu-toggle" id="menu-toggle" aria-label="Menu">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <!-- Page Hero -->
        <section class="page-hero">
            <div class="container">
                <span class="section__tag fade-in">Nossos Trabalhos</span>
                <h1 class="page-hero__title fade-in">Portfólio</h1>
                <p class="page-hero__description fade-in">
                    Cada projeto é único e pensado estrategicamente para gerar resultados.
                </p>
            </div>
        </section>

        <!-- Portfolio Grid -->
        <section class="section">
            <div class="container">
                <div class="portfolio__grid">
                    {projects.map(project => (
                        <a href={`/portfolio/${project.id}`} class="portfolio-card fade-in">
                            <img src={project.data.thumbnail} alt={project.data.client} style={project.id === "dubelato" ? "object-fit: contain; background: #ffffff; padding: 8px;" : ""}>
                            <div class="portfolio-card__overlay">
                                <span class="portfolio-card__tag">{project.data.category}</span>
                                <h3 class="portfolio-card__title">{project.data.client}</h3>
                                <span class="portfolio-card__cta">Clique para ver</span>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="section cases">
            <div class="container" style="text-align: center;">
                <h2 class="section__title fade-in" style="color: var(--white);">Quer ver sua marca aqui?</h2>
                <p class="section__description fade-in"
                    style="color: var(--gray-400); margin-bottom: var(--space-2xl);">
                    Entre em contato e vamos criar algo incrível juntos.
                </p>
                <a href="index.html#contato" class="btn btn--primary fade-in">Iniciar Projeto</a>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <Footer />

    <a href="https://api.whatsapp.com/send?l=pt_BR&phone=551634154110" class="whatsapp-btn" target="_blank"
        aria-label="WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
    </a>

    <script src="/script.js" is:inline></script>
</body>

</html>