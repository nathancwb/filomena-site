        .influencia-stat:hover .influencia-stat__number {
            transform: translateY(-10px) scale(1.05);
            text-shadow: 0 6px 24px rgba(0, 0, 0, 0.5), 0 0 35px rgba(208, 143, 255, 0.6);
        }

