---
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import AnalyticsNoscript from '../components/AnalyticsNoscript.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <Analytics />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="index, follow">
    <title>Marketing de Influência que Vende | Filomena Propaganda</title>
    <meta name="description" content="Conectamos sua marca aos criadores certos, com estratégia, curadoria humana e relatório de resultado, do briefing à entrega. Peça uma proposta.">

    <link rel="canonical" href="https://www.filomenapropaganda.com.br/marketing-de-influencia/" />
    <link rel="alternate" hreflang="pt-BR" href="https://www.filomenapropaganda.com.br/marketing-de-influencia/" />
    <link rel="alternate" hreflang="x-default" href="https://www.filomenapropaganda.com.br/marketing-de-influencia/" />
    <link rel="alternate" type="text/markdown" href="/marketing-de-influencia.md" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Marketing de Influência que Vende | Filomena Propaganda" />
    <meta property="og:description" content="Conectamos sua marca aos criadores certos, com estratégia, curadoria humana e relatório de resultado, do briefing à entrega." />
    <meta property="og:url" content="https://www.filomenapropaganda.com.br/marketing-de-influencia/" />
    <meta property="og:site_name" content="Filomena Propaganda" />
    <meta property="og:image" content="https://www.filomenapropaganda.com.br/assets/images/og-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Marketing de Influência que Vende | Filomena Propaganda" />
    <meta name="twitter:description" content="Conectamos sua marca aos criadores certos, com estratégia, curadoria humana e relatório de resultado, do briefing à entrega." />
    <meta name="twitter:image" content="https://www.filomenapropaganda.com.br/assets/images/og-preview.png" />

    <!-- GEO Geotagging / Local SEO -->
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="São Carlos" />
    <meta name="geo.position" content="-22.008978;-47.887784" />
    <meta name="ICBM" content="-22.008978, -47.887784" />

    <!-- Service Schema -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Influencer Marketing",
      "name": "Marketing de Influência",
      "provider": {
        "@type": ["Organization", "AdvertisingAgency", "LocalBusiness"],
        "name": "Filomena Propaganda",
        "legalName": "Filomena Propaganda e Marketing Ltda",
        "url": "https://www.filomenapropaganda.com.br",
        "telephone": "+551634154110",
        "email": "contato@filomenapropaganda.com.br",
        "logo": "https://www.filomenapropaganda.com.br/assets/images/logo-main.webp",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Rua Dom Pedro II, 1978",
          "addressLocality": "São Carlos",
          "addressRegion": "SP",
          "postalCode": "13560-235",
          "addressCountry": "BR"
        }
      },
      "areaServed": "BR",
      "description": "Serviço ponta a ponta de marketing de influência: diagnóstico, curadoria de criadores, negociação, gestão de campanha e relatório de resultados."
    }
    </script>

    <!-- FAQ Schema -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto custa uma campanha de influência?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O investimento varia conforme o número de criadores, formato de conteúdo e alcance desejado. Na proposta, apresentamos opções para diferentes orçamentos."
          }
        },
        {
          "@type": "Question",
          "name": "Em quanto tempo vejo resultado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As primeiras publicações costumam sair poucas semanas após o início do projeto; os primeiros dados de engajamento e conversão chegam logo depois, e ficam disponíveis no relatório de acompanhamento."
          }
        },
        {
          "@type": "Question",
          "name": "Como vocês escolhem os influenciadores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Com curadoria por afinidade de público, histórico de entrega e engajamento real, nunca só pelo número de seguidores."
          }
        },
        {
          "@type": "Question",
          "name": "Funciona para qualquer segmento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Adaptamos a estratégia e o perfil de criadores ao setor e ao público da marca, de moda e beleza a alimentos e tecnologia."
          }
        },
        {
          "@type": "Question",
          "name": "Preciso ter uma verba mínima?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não existe uma verba fixa, o formato da campanha se adapta ao objetivo e orçamento disponível."
          }
        }
      ]
    }
    </script>

    <link rel="preload" href="/assets/fonts/OliviarSans-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <AnalyticsNoscript />
    <div class="noise-overlay"></div>

    <!-- Header -->
    <header class="header">
        <div class="header__inner container">
            <a href="/" class="logo">
                <img src="/assets/images/logo-main.webp" alt="Filomena Propaganda & Marketing" class="logo__img">
            </a>

            <nav class="nav">
                <ul class="nav__list" id="nav-menu">
                    <li><a href="/" class="nav__link">Home</a></li>
                    <li><a href="/sobre/" class="nav__link">Sobre</a></li>
                    <li><a href="/servicos/" class="nav__link">Serviços</a></li>
                    <li><a href="/portfolio/" class="nav__link">Portfólio</a></li>
                    <li><a href="/blog/" class="nav__link">Blog</a></li>
                    <li><a href="/trabalhe-conosco/" class="nav__link">Trabalhe Conosco</a></li>
                    <li><a href="/contato/" class="nav__link">Contato</a></li>
                </ul>

                <div class="nav__actions">
                    <button class="menu-toggle" id="menu-toggle" aria-label="Menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <!-- Hero -->
        <section class="influencia-hero">
            <div class="container">
                <div class="influencia-hero__grid">
                    <div class="influencia-hero__content">
                        <h1 class="influencia-hero__title fade-in">Marketing de influência que <span class="influencia-hero__highlight">vende</span>, não só aparece.</h1>
                        <p class="influencia-hero__description fade-in">
                            Conectamos sua marca aos criadores certos, com estratégia, curadoria humana e relatório de resultado, do briefing à entrega.
                        </p>
                        <div class="fade-in influencia-hero__actions">
                            <a href="#contato" class="btn btn--primary">Quero uma proposta →</a>
                            <a href="#processo" class="btn btn--outline influencia-hero__btn-outline">Como funciona</a>
                        </div>
                    </div>

                    <!-- Realistic Smartphone Device Frame with Steady Remotion Video -->
                    <div class="influencia-hero__art" aria-hidden="true">
                        <div class="influencia-phone-glow"></div>
                        <div class="influencia-phone">
                            <div class="influencia-phone__notch"></div>
                            <div class="influencia-phone__screen">
                                <video
                                    class="influencia-phone__video"
                                    src="/videos/influencer-post.mp4"
                                    autoplay
                                    loop
                                    muted
                                    playsinline
                                    preload="auto"
                                    aria-label="Demonstração animada de post e vendas de influenciador"
                                ></video>
                            </div>
                            <div class="influencia-phone__bar"></div>
                        </div>
                    </div>
                </div>

                <!-- Estatísticas (Mesma Cor da Hero, Sem Caixa, Números Brancos Flutuando) -->
                <div class="influencia-stats-wrap fade-in">
                    <div class="influencia-stats">
                        <div class="influencia-stat influencia-stat--1">
                            <span class="influencia-stat__number">65%</span>
                            <span class="influencia-stat__label">já compraram por recomendação de um influenciador</span>
                        </div>
                        <div class="influencia-stat influencia-stat--2">
                            <span class="influencia-stat__number">5,2x</span>
                            <span class="influencia-stat__label">retorno médio sobre o investimento no Brasil</span>
                        </div>
                        <div class="influencia-stat influencia-stat--3">
                            <span class="influencia-stat__number">87%</span>
                            <span class="influencia-stat__label">ficaram satisfeitos com a compra indicada</span>
                        </div>
                    </div>
                    <p class="influencia-stats__sources">
                        Fontes: Opinion Box e Influency.me (2025), Sprout Social (2025) e Empreender.com.br
                    </p>
                </div>
            </div>
        </section>

        <!-- Como trabalhamos (Cards 3D com Entrada Lateral no Scroll) -->
        <section class="section section--alt process-3d-section" id="processo">
            <div class="container">
                <div class="section__header section__header--center">
                    <span class="section__tag fade-in">Como trabalhamos</span>
                    <h2 class="section__title fade-in">
                        Um serviço ponta a ponta, não uma lista de indicações
                    </h2>
                    <p class="section__description fade-in">
                        Do primeiro contato à entrega do relatório: cuidamos de cada detalhe para transformar criadores e campanhas em autoridade e vendas reais.
                    </p>
                </div>

                <div class="process-3d-grid">
                    <!-- Card 01 (Entrada pela Esquerda) -->
                    <div class="card-3d card-3d--left" data-step="1">
                        <div class="card-3d__glare"></div>
                        <div class="card-3d__content">
                            <div class="card-3d__header">
                                <span class="card-3d__number">01</span>
                                <span class="card-3d__badge">Etapa 01</span>
                            </div>
                            <h3 class="card-3d__title">Diagnóstico &amp; Estratégia</h3>
                            <p class="card-3d__text">
                                Entendimento do público, objetivo da campanha (vendas, awareness ou lançamento) e definição clara de KPIs de performance.
                            </p>
                            <div class="card-3d__indicator"></div>
                        </div>
                    </div>

                    <!-- Card 02 (Entrada pela Direita) -->
                    <div class="card-3d card-3d--right" data-step="2">
                        <div class="card-3d__glare"></div>
                        <div class="card-3d__content">
                            <div class="card-3d__header">
                                <span class="card-3d__number">02</span>
                                <span class="card-3d__badge">Etapa 02</span>
                            </div>
                            <h3 class="card-3d__title">Curadoria de Criadores</h3>
                            <p class="card-3d__text">
                                Seleção por afinidade real com a marca, com negociação e contrato incluídos: condições claras de entrega, prazo e uso de imagem.
                            </p>
                            <div class="card-3d__indicator"></div>
                        </div>
                    </div>

                    <!-- Card 03 (Entrada pela Esquerda) -->
                    <div class="card-3d card-3d--left" data-step="3">
                        <div class="card-3d__glare"></div>
                        <div class="card-3d__content">
                            <div class="card-3d__header">
                                <span class="card-3d__number">03</span>
                                <span class="card-3d__badge">Etapa 03</span>
                            </div>
                            <h3 class="card-3d__title">Gestão de Campanha</h3>
                            <p class="card-3d__text">
                                Acompanhamento de produção, aprovação de conteúdo e cronograma de publicação, sem você precisar administrar dezenas de conversas.
                            </p>
                            <div class="card-3d__indicator"></div>
                        </div>
                    </div>

                    <!-- Card 04 (Entrada pela Direita) -->
                    <div class="card-3d card-3d--right" data-step="4">
                        <div class="card-3d__glare"></div>
                        <div class="card-3d__content">
                            <div class="card-3d__header">
                                <span class="card-3d__number">04</span>
                                <span class="card-3d__badge">Etapa 04</span>
                            </div>
                            <h3 class="card-3d__title">Relatório de Resultados &amp; ROI</h3>
                            <p class="card-3d__text">
                                Métricas completas de alcance, engajamento, cliques e conversões entregues ao final de cada campanha, com resultado repetível e sem depender de sorte.
                            </p>
                            <div class="card-3d__indicator"></div>
                        </div>
                    </div>
                </div>

                <p class="fade-in" style="text-align: center; max-width: 640px; margin: var(--space-3xl) auto 0; color: var(--text-muted);">
                    Do primeiro contato à primeira publicação, o processo costuma levar poucas semanas: o prazo exato varia com o tamanho da campanha e a disponibilidade dos criadores selecionados.
                </p>
            </div>
        </section>

        <!-- Diferenciais -->
        <section class="section" id="diferenciais">
            <div class="container">
                <div class="section__header section__header--center">
                    <span class="section__tag fade-in">Por que trabalhar com a gente</span>
                    <h2 class="section__title fade-in">Critério, método e transparência</h2>
                    <p class="section__description fade-in" style="margin-left: auto; margin-right: auto;">
                        Banco de criadores já mapeado por nicho, engajamento e histórico de entrega, reduzindo o tempo entre a decisão e a primeira publicação.
                    </p>
                </div>

                <div class="diferenciais-grid">
                    <!-- Diferencial 1 -->
                    <div class="diferencial-card fade-in">
                        <div class="diferencial-card__top">
                            <div class="diferencial-card__icon" aria-hidden="true">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <circle cx="12" cy="12" r="6"></circle>
                                    <circle cx="12" cy="12" r="2"></circle>
                                </svg>
                            </div>
                            <span class="diferencial-card__tag">Afinidade Real</span>
                        </div>
                        <h3 class="diferencial-card__title">Curadoria com critério</h3>
                        <p class="diferencial-card__text">
                            Selecionamos criadores pela afinidade real com o público da sua marca: taxa de engajamento genuíno importa mais que volume de seguidores.
                        </p>
                    </div>

                    <!-- Diferencial 2 -->
                    <div class="diferencial-card fade-in">
                        <div class="diferencial-card__top">
                            <div class="diferencial-card__icon" aria-hidden="true">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                                </svg>
                            </div>
                            <span class="diferencial-card__tag">Processo Previsível</span>
                        </div>
                        <h3 class="diferencial-card__title">Metodologia própria</h3>
                        <p class="diferencial-card__text">
                            Cada campanha segue um processo estruturado, do briefing ao relatório de ROI, para que o resultado seja consistente e mensurável.
                        </p>
                    </div>

                    <!-- Diferencial 3 -->
                    <div class="diferencial-card fade-in">
                        <div class="diferencial-card__top">
                            <div class="diferencial-card__icon" aria-hidden="true">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    <path d="m9 12 2 2 4-4"></path>
                                </svg>
                            </div>
                            <span class="diferencial-card__tag">Sem Custos Ocultos</span>
                        </div>
                        <h3 class="diferencial-card__title">Transparência de ponta a ponta</h3>
                        <p class="diferencial-card__text">
                            Você acompanha custos de cachês, entregas e métricas durante toda a campanha, com visibilidade contínua e sem surpresas.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA intermediário -->
        <section class="influencia-cta-banner">
            <div class="container">
                <h2 class="influencia-cta-banner__title fade-in">Vamos estruturar a campanha da sua marca?</h2>
                <a href="#contato" class="btn btn--primary fade-in">Quero uma proposta →</a>
            </div>
        </section>

        <!-- Cases & Resultados (Layout Wide no Desktop, Navegação Completa e Compacta no Mobile) -->
        <section class="section section--alt" id="cases">
            <div class="container cases-container">
                <div class="section__header section__header--center cases-header">
                    <span class="section__tag fade-in">Cases &amp; Resultados</span>
                    <h2 class="section__title fade-in">Resultado real, contado por quem viveu</h2>
                    <p class="section__description fade-in">
                        Conheça como a curadoria humana e a execução de ponta a ponta constroem autoridade e tração de vendas para nossos clientes.
                    </p>
                </div>

                <!-- Seletor de Cases no Mobile (Aparece tudo na mesma tela sem corte) -->
                <div class="influencia-cases-tabs fade-in" role="tablist" aria-label="Navegar por Cases">
                    <button class="influencia-case-tab is-active" data-case-target="0" role="tab" aria-selected="true" aria-controls="case-item-0">
                        <span class="influencia-case-tab__name">Boali</span>
                        <span class="influencia-case-tab__sub">Alimentação</span>
                    </button>
                    <button class="influencia-case-tab" data-case-target="1" role="tab" aria-selected="false" aria-controls="case-item-1">
                        <span class="influencia-case-tab__name">Latina</span>
                        <span class="influencia-case-tab__sub">Eletrodomésticos</span>
                    </button>
                    <button class="influencia-case-tab" data-case-target="2" role="tab" aria-selected="false" aria-controls="case-item-2">
                        <span class="influencia-case-tab__name">Colégio Ábaco</span>
                        <span class="influencia-case-tab__sub">Educação</span>
                    </button>
                </div>

                <div class="influencia-cases-list">
                    <!-- Case 1: Boali -->
                    <article class="influencia-case-item is-active fade-in" id="case-item-0" data-case-index="0">
                        <div class="influencia-case-item__media">
                            <div class="video-card" data-video-card>
                                <div class="video-card__media">
                                    <img src="/assets/images/portfolio/boali-outdoor1.webp" alt="Depoimento Boali" class="video-card__poster" loading="lazy" decoding="async">
                                    <video class="video-card__player" preload="none" controls playsinline poster="/assets/images/portfolio/boali-outdoor1.webp">
                                        <source src="/assets/videos/depoimento-boali.mp4" type="video/mp4">
                                    </video>
                                    <button class="video-card__play-btn" type="button" aria-label="Assistir Depoimento Boali">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                                    </button>
                                    <button class="video-card__close-btn" type="button" aria-label="Minimizar vídeo" title="Minimizar vídeo">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="influencia-case-item__content">
                            <div class="influencia-case-item__tag-row">
                                <span class="case-item__tag">Alimentação Saudável</span>
                            </div>
                            <div class="influencia-case-brand-heading">
                                <img src="/assets/images/clients/client-boali.svg" alt="Boali" class="influencia-case-item__logo">
                                <h3 class="sr-only">Boali</h3>
                            </div>
                            <p class="influencia-case-item__subtitle">Líder nacional em alimentação saudável e franquias.</p>
                            
                            <div class="influencia-case-meta">
                                <div class="influencia-case-column">
                                    <span class="influencia-case-label">Desafio</span>
                                    <p class="influencia-case-text">Inauguração e posicionamento da nova unidade em São Carlos.</p>
                                </div>
                                <div class="influencia-case-column">
                                    <span class="influencia-case-label">Estratégia</span>
                                    <p class="influencia-case-text">Curadoria de creators de saúde/lifestyle com press kits e almoço inaugural exclusivo.</p>
                                </div>
                            </div>

                            <blockquote class="influencia-case-quote">
                                <p class="influencia-case-quote__text">"A curadoria fez toda a diferença: os criadores realmente conversavam com o nosso público, e isso apareceu direto nas vendas."</p>
                                <cite class="influencia-case-quote__author">— Victor, Franqueado Boali São Carlos</cite>
                            </blockquote>

                            <!-- Controles de Navegação no Mobile -->
                            <div class="influencia-case-mobile-nav">
                                <button type="button" class="influencia-case-nav-btn is-next" data-next-case="1">
                                    <span>Próximo Case: Latina</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </button>
                            </div>
                        </div>
                    </article>

                    <!-- Case 2: Latina Eletrodomésticos -->
                    <article class="influencia-case-item influencia-case-item--reverse fade-in" id="case-item-1" data-case-index="1">
                        <div class="influencia-case-item__media">
                            <div class="video-card" data-video-card>
                                <div class="video-card__media">
                                    <img src="/assets/images/portfolio/latina-frente.webp" alt="Ação com Creators Latina" class="video-card__poster" loading="lazy" decoding="async">
                                    <video class="video-card__player" preload="none" controls playsinline poster="/assets/images/portfolio/latina-frente.webp">
                                        <source src="/assets/videos/depoimento-latina.mp4" type="video/mp4">
                                    </video>
                                    <button class="video-card__play-btn" type="button" aria-label="Assistir Vídeo Latina">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                                    </button>
                                    <button class="video-card__close-btn" type="button" aria-label="Minimizar vídeo" title="Minimizar vídeo">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
