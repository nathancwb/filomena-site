        /* Estatísticas dentro da Hero (Mesma Cor, Sem Caixa, Números Brancos Flutuantes) */
        .influencia-stats-wrap {
            margin-top: var(--space-2xl);
            padding-top: var(--space-xl);
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            position: relative;
            z-index: 2;
