        /* Vídeos de Depoimento & Ação (Transformação Vertical Suave) */
        .video-card {
            background: none;
            border: none;
            box-shadow: none;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            border-radius: 0;
            overflow: visible;
            display: flex;
            flex-direction: column;
            width: 100%;
        }

        .video-card__media {
            position: relative;
            width: 100%;
            aspect-ratio: 16/9;
            background: #0d0314;
            overflow: hidden;
            cursor: pointer;
            border-radius: 18px;
            border: 1px solid rgba(89, 38, 109, 0.12);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            transition: aspect-ratio 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                        box-shadow 0.4s ease,
                        border-color 0.4s ease;
        }

        .video-card:not(.is-playing):hover .video-card__media {
            transform: translateY(-3px);
            border-color: rgba(89, 38, 109, 0.3);
            box-shadow: 0 14px 32px rgba(89, 38, 109, 0.18);
        }

        .video-card.is-playing .video-card__media {
            aspect-ratio: 9/16;
            max-height: min(780px, 82vh);
            max-width: 100%;
            margin: 0 auto;
            border-radius: 18px;
            border: 1px solid rgba(89, 38, 109, 0.2);
            box-shadow: 0 20px 48px rgba(0, 0, 0, 0.25);
        }

        .video-card:not(.is-playing):hover .video-card__poster {
            transform: scale(1.03);
            filter: brightness(0.95);
        }

        .video-card__poster {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease, filter 0.4s ease, opacity 0.4s ease;
        }

        .video-card__player {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
            background: #000;
            border-radius: inherit;
        }

        .video-card.is-playing .video-card__poster,
        .video-card.is-playing .video-card__play-btn {
            opacity: 0;
            pointer-events: none;
            display: none;
        }

        .video-card.is-playing .video-card__player {
            display: block;
        }

        .video-card__close-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: var(--white);
            display: none;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: background 0.3s ease, transform 0.3s ease;
        }

        .video-card.is-playing .video-card__close-btn {
            display: flex;
        }

        .video-card__close-btn:hover {
            background: rgba(0, 0, 0, 0.95);
            transform: scale(1.1);
        }

        .video-card__play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(89, 38, 109, 0.9);
            backdrop-filter: blur(8px);
            border: 2px solid rgba(255, 255, 255, 0.8);
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
            z-index: 2;
        }

        .video-card__play-btn svg {
            margin-left: 2px;
        }

        .video-card:hover .video-card__play-btn {
            transform: translate(-50%, -50%) scale(1.12);
            background: var(--accent);
            box-shadow: 0 0 24px rgba(89, 38, 109, 0.5);
        }

        /* Headers e Títulos Amplos e Horizontais (sem amontoamento) */
        .section__header {
            max-width: 1200px !important;
            width: 100% !important;
            margin-bottom: var(--space-3xl);
        }

        .section__header--center {
            text-align: center;
            margin-left: auto;
            margin-right: auto;
        }

        .section__header .section__title,
        .section__title {
            max-width: 100% !important;
            width: 100% !important;
            margin-left: auto;
            margin-right: auto;
            font-size: clamp(1.75rem, 2.8vw, 2.5rem);
            line-height: 1.2;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

        .section__header .section__description,
        .section__description {
            max-width: 1000px !important;
            width: 100% !important;
            margin-left: auto;
            margin-right: auto;
            font-size: var(--text-base);
            line-height: 1.6;
            text-wrap: balance;
        }

        /* Cases & Resultados (Layout Wide com Todos os Cases e Vídeos) */
        .cases-container {
            max-width: 1380px;
        }

        .influencia-cases-list {
            display: flex;
            flex-direction: column;
            gap: var(--space-3xl);
        }

        .influencia-case-item {
            background: var(--white);
            display: grid;
            grid-template-columns: minmax(380px, 480px) 1fr;
            gap: var(--space-3xl);
            align-items: center;
            padding: var(--space-3xl);
            border-radius: 24px;
            border: 1px solid rgba(89, 38, 109, 0.08);
            box-shadow: 0 10px 36px rgba(0, 0, 0, 0.04);
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .influencia-case-item:hover {
            border-color: rgba(89, 38, 109, 0.16);
            box-shadow: 0 16px 48px rgba(89, 38, 109, 0.08);
        }

        .influencia-case-item--reverse {
            grid-template-columns: 1fr minmax(380px, 480px);
        }

        .influencia-case-item--reverse .influencia-case-item__media {
            order: 2;
        }

        .influencia-case-item--reverse .influencia-case-item__content {
            order: 1;
        }

        .influencia-case-item__media {
            width: 100%;
        }

        .influencia-case-item__img-wrapper {
            position: relative;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }

        .influencia-case-item__img-wrapper > img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            display: block;
            border-radius: 18px;
            transition: transform 0.5s ease;
        }

        .influencia-case-item:hover .influencia-case-item__img-wrapper > img {
            transform: scale(1.03);
        }

        .influencia-case-item__gallery {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 8px;
        }

        .influencia-case-item__gallery img {
            width: 100%;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid rgba(89, 38, 109, 0.08);
        }

        .influencia-case-item__content {
            display: flex;
            flex-direction: column;
            gap: var(--space-sm);
        }

        .influencia-case-item__client-header {
            display: flex;
            align-items: center;
            gap: var(--space-md);
        }

        .influencia-case-item__logo {
            height: 28px;
            max-width: 130px;
            object-fit: contain;
            filter: none;
        }

        .case-item__tag {
            font-size: var(--text-xs);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            background: rgba(89, 38, 109, 0.08);
            color: var(--accent);
            padding: 4px 10px;
            border-radius: 6px;
        }

        .influencia-case-item__title {
            font-family: var(--font-heading);
            font-size: clamp(var(--text-xl), 2.2vw, var(--text-2xl));
            font-weight: 700;
            color: var(--text-color);
            margin: 0;
            line-height: 1.2;
        }

        .influencia-case-item__subtitle {
            font-size: var(--text-sm);
            color: var(--text-muted);
            margin-top: -2px;
            font-weight: 500;
        }

        .influencia-case-block {
            background: rgba(89, 38, 109, 0.03);
            border-left: 3px solid var(--accent);
            padding: var(--space-xs) var(--space-md);
            border-radius: 0 6px 6px 0;
        }

        .influencia-case-block strong {
            display: block;
            color: var(--text-color);
            font-size: var(--text-xs);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 2px;
        }

        .influencia-case-block p {
            font-size: var(--text-sm);
            color: var(--text-muted);
            line-height: 1.5;
            margin: 0;
        }

        .influencia-case-testimonial {
            background: rgba(89, 38, 109, 0.04);
            border-left: 3px solid var(--accent);
            padding: var(--space-xs) var(--space-md);
            border-radius: 0 6px 6px 0;
            margin-top: 2px;
        }

        .influencia-case-testimonial__quote {
            font-size: var(--text-sm);
            color: var(--text-color);
            font-style: italic;
            line-height: 1.5;
            margin: 0;
        }

        .influencia-case-testimonial__author {
            font-size: var(--text-xs);
            font-weight: 600;
            color: var(--accent);
            margin-top: 4px;
            margin-bottom: 0;
        }

        /* Chamada para Influenciadores */
        .creators-callout-section {
            padding-top: var(--space-2xl);
            padding-bottom: var(--space-2xl);
        }

        .creators-callout {
            padding: var(--space-3xl) var(--space-2xl);
            text-align: center;
            border-radius: 24px;
            background: linear-gradient(135deg, #3d144e 0%, #1c0828 100%);
            border: 1px solid rgba(208, 143, 255, 0.35);
            box-shadow: 0 24px 48px rgba(30, 10, 42, 0.35);
            color: var(--white);
        }

        .creators-callout .section__tag {
            color: var(--secondary-light);
            background: rgba(208, 143, 255, 0.15);
            border: 1px solid rgba(208, 143, 255, 0.3);
            display: inline-block;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: var(--text-xs);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .creators-callout__title {
            font-family: var(--font-heading);
            font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
            color: var(--white);
            max-width: 720px;
            margin: var(--space-md) auto var(--space-sm);
            line-height: 1.25;
            font-weight: 700;
        }

        .creators-callout__text {
            font-size: var(--text-base);
            color: rgba(255, 255, 255, 0.88);
            max-width: 640px;
            margin: 0 auto var(--space-xl);
            line-height: 1.6;
        }

        @media (max-width: 900px) {
            .influencia-case-item,
            .influencia-case-item--reverse {
                grid-template-columns: 1fr;
                gap: var(--space-xl);
                padding: var(--space-xl);
            }

            .influencia-case-item--reverse .influencia-case-item__media {
                order: 1;
            }

            .influencia-case-item--reverse .influencia-case-item__content {
                order: 2;
            }

            .influencia-case-item__img-wrapper > img {
                height: 220px;
            }
        }

        /* CTA banner intermediário */
        .influencia-cta-banner {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, var(--accent-dark), #2a0f3a);
            padding: var(--space-3xl) 0;
            text-align: center;
        }

        .influencia-cta-banner::before,
        .influencia-cta-banner::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(208, 143, 255, 0.35), transparent 70%);
            pointer-events: none;
        }

        .influencia-cta-banner::before {
            width: 360px;
            height: 360px;
            top: -180px;
            left: -100px;
        }

        .influencia-cta-banner::after {
            width: 280px;
            height: 280px;
            bottom: -160px;
            right: -80px;
        }

        .influencia-cta-banner .container {
            position: relative;
            z-index: 1;
        }

        .influencia-cta-banner__title {
            font-family: var(--font-heading);
            font-size: clamp(var(--text-2xl), 3.5vw, var(--text-4xl));
            color: var(--white);
            margin-bottom: var(--space-lg);
        }
    </style>

    <script src="/script.js" is:inline></script>

    <!-- Envio do formulário via Web3Forms (AJAX, sem recarregar a página) -->
    <script is:inline>
      (function () {
        const form = document.getElementById('influencia-form');
        if (!form) return;
        const status = document.getElementById('influencia-form-status');
        const button = form.querySelector('button[type="submit"]');
        const buttonLabel = button ? button.innerHTML : '';
        const whatsappUrl = 'https://api.whatsapp.com/send?l=pt_BR&phone=551634154110&text=Ol%C3%A1!%20Vim%20da%20p%C3%A1gina%20de%20Marketing%20de%20Influ%C3%AAncia%20e%20quero%20uma%20proposta.';

        function showStatus(message, isError) {
          if (!status) return;
          status.innerHTML = message;
          status.style.display = 'block';
          status.style.background = isError ? 'rgba(229, 57, 53, 0.12)' : 'rgba(67, 160, 71, 0.12)';
          status.style.color = isError ? '#c62828' : '#2e7d32';
          status.style.border = '1px solid ' + (isError ? 'rgba(229, 57, 53, 0.4)' : 'rgba(67, 160, 71, 0.4)');
        }

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          const honeypot = form.querySelector('input[name="b_website"]');
          if (honeypot && honeypot.value) return;

          if (button) {
            button.disabled = true;
            button.innerHTML = 'Enviando...';
          }
          if (status) status.style.display = 'none';

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: new FormData(form),
            });
            const data = await response.json();

            if (response.ok && data.success) {
              showStatus('✅ Proposta solicitada! Em breve entraremos em contato.', false);
              form.reset();

              if (typeof window !== 'undefined') {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                  event: 'generate_lead',
                  form_name: 'lp_marketing_influencia'
                });
                if (window.gtag) {
                  window.gtag('event', 'generate_lead', {
                    event_category: 'Formulário',
                    event_label: 'LP Marketing de Influência',
                    value: 1
                  });
                }
                if (window.fbq) {
                  window.fbq('track', 'Lead', {
                    content_name: 'LP Marketing de Influência',
                    value: 1,
                    currency: 'BRL'
                  });
                }
              }
            } else {
              showStatus(
                '❌ Não foi possível enviar agora. Fale com a gente pelo <a href="' +
                  whatsappUrl +
                  '" target="_blank" style="color: inherit; text-decoration: underline;">WhatsApp</a>.',
                true
              );
            }
          } catch (error) {
            showStatus(
              '❌ Erro de conexão. Tente novamente ou fale pelo <a href="' +
                whatsappUrl +
                '" target="_blank" style="color: inherit; text-decoration: underline;">WhatsApp</a>.',
              true
            );
          } finally {
            if (button) {
              button.disabled = false;
              button.innerHTML = buttonLabel;
            }
          }
        });

        // Video card vertical playback controller
        const videoCards = document.querySelectorAll('.video-card');
        videoCards.forEach((card) => {
          const media = card.querySelector('.video-card__media');
          const playBtn = card.querySelector('.video-card__play-btn');
          const closeBtn = card.querySelector('.video-card__close-btn');
          const video = card.querySelector('.video-card__player');
          if (!media || !video) return;

          const openVerticalVideo = () => {
            // Pause any other active video cards
            videoCards.forEach((otherCard) => {
              if (otherCard !== card && otherCard.classList.contains('is-playing')) {
                const otherVid = otherCard.querySelector('.video-card__player');
                if (otherVid) otherVid.pause();
                otherCard.classList.remove('is-playing');
              }
            });

            if (!card.classList.contains('is-playing')) {
              card.classList.add('is-playing');
              video.currentTime = 0;
              video.play().catch(() => {});

              // Smoothly accompany the video into center view
              setTimeout(() => {
                const caseItem = card.closest('.influencia-case-item') || card;
                caseItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }, 120);
            }
          };

          const closeVerticalVideo = () => {
            card.classList.remove('is-playing');
            video.pause();

            setTimeout(() => {
              const caseItem = card.closest('.influencia-case-item') || card;
              caseItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 80);
          };

          if (playBtn) {
            playBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              openVerticalVideo();
            });
          }

          media.addEventListener('click', (e) => {
            if (e.target.closest('.video-card__close-btn')) {
              e.stopPropagation();
              closeVerticalVideo();
              return;
            }
            if (!card.classList.contains('is-playing')) {
              openVerticalVideo();
            }
          });

          if (closeBtn) {
            closeBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              closeVerticalVideo();
            });
          }

          video.addEventListener('ended', () => {
            closeVerticalVideo();
          });
        });
      })();
    </script>
</body>

</html>
