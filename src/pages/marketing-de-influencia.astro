    <!-- Envio do formulário via Web3Forms (AJAX, sem recarregar a página) -->
    <script is:inline>
      (function () {
        const form = document.getElementById('influencia-form');
        if (!form) return;
        const status = document.getElementById('influencia-form-status');
        const button = form.querySelector('button[type="submit"]');
        const buttonLabel = button ? button.innerHTML : '';
        const whatsappUrl = 'https://api.whatsapp.com/send?l=pt_BR&phone=551634154110&text=Ol%C3%A1!%20Vim%20da%20p%C3%A1gina%20de%20Marketing%20de%20Influ%C3%AAncia%20e%20quero%20uma%20proposta.';

        function showStatus(message, isError) {
          if (!status) return;
          status.innerHTML = message;
          status.style.display = 'block';
          status.style.background = isError ? 'rgba(229, 57, 53, 0.12)' : 'rgba(67, 160, 71, 0.12)';
          status.style.color = isError ? '#c62828' : '#2e7d32';
          status.style.border = '1px solid ' + (isError ? 'rgba(229, 57, 53, 0.4)' : 'rgba(67, 160, 71, 0.4)');
        }

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          const honeypot = form.querySelector('input[name="b_website"]');
          if (honeypot && honeypot.value) return;

          if (button) {
            button.disabled = true;
            button.innerHTML = 'Enviando...';
          }
          if (status) status.style.display = 'none';

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: new FormData(form),
            });
            const data = await response.json();

            if (response.ok && data.success) {
              showStatus('✅ Proposta solicitada! Em breve entraremos em contato.', false);
              form.reset();

              if (typeof window !== 'undefined') {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                  event: 'generate_lead',
                  form_name: 'lp_marketing_influencia'
                });
                if (window.gtag) {
                  window.gtag('event', 'generate_lead', {
                    event_category: 'Formulário',
                    event_label: 'LP Marketing de Influência',
                    value: 1
                  });
                }
                if (window.fbq) {
                  window.fbq('track', 'Lead', {
                    content_name: 'LP Marketing de Influência',
                    value: 1,
                    currency: 'BRL'
                  });
                }
              }
            } else {
              showStatus(
                '❌ Não foi possível enviar agora. Fale com a gente pelo <a href="' +
                  whatsappUrl +
                  '" target="_blank" style="color: inherit; text-decoration: underline;">WhatsApp</a>.',
                true
              );
            }
          } catch (error) {
            showStatus(
              '❌ Erro de conexão. Tente novamente ou fale pelo <a href="' +
                whatsappUrl +
                '" target="_blank" style="color: inherit; text-decoration: underline;">WhatsApp</a>.',
              true
            );
          } finally {
            if (button) {
              button.disabled = false;
              button.innerHTML = buttonLabel;
            }
          }
        });
      })();
    </script>
