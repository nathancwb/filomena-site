    <style>
        .influencia-hero {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, var(--accent-dark), #2a0f3a);
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: calc(var(--header-height) + 3.5rem) 0 var(--space-xl);
            box-sizing: border-box;
        }

        .influencia-hero > .container {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex: 1;
            width: 100%;
        }

        .influencia-hero__art {
            position: absolute;
            top: 40%;
            right: max(40px, calc((100vw - 1400px) / 2));
            transform: translateY(-50%);
            width: clamp(220px, 18vw, 280px);
            height: auto;
            pointer-events: none;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .influencia-phone-glow {
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(208, 143, 255, 0.28) 0%, rgba(89, 38, 109, 0) 70%);
            filter: blur(40px);
            z-index: 1;
            pointer-events: none;
        }

        .influencia-phone {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 270px;
            aspect-ratio: 9 / 16;
            background: #12051b;
            border-radius: 36px;
            padding: 7px;
            box-shadow: 
                0 25px 60px rgba(0, 0, 0, 0.7),
                0 0 0 1.5px rgba(255, 255, 255, 0.16),
                inset 0 0 0 1.5px rgba(208, 143, 255, 0.2);
            box-sizing: border-box;
            transform: rotate(2deg);
            transition: transform 0.4s ease;
        }

        .influencia-phone__notch {
            position: absolute;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 14px;
            background: #000000;
            border-radius: 8px;
            z-index: 10;
        }

        .influencia-phone__screen {
            position: relative;
            width: 100%;
            height: 100%;
            border-radius: 28px;
            overflow: hidden;
            background: #0d0414;
        }

        .influencia-phone__video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .influencia-phone__bar {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            width: 70px;
            height: 3px;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 2px;
            z-index: 10;
        }

        .influencia-hero__content {
            position: relative;
            z-index: 2;
            max-width: 840px;
            text-align: left;
            margin: auto 0;
            padding: var(--space-sm) 0;
        }

        .influencia-hero__tag {
            display: inline-block;
            font-size: var(--text-xs);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--secondary-light);
            margin-bottom: var(--space-md);
        }

        .influencia-hero__title {
            font-family: var(--font-heading);
            font-size: clamp(2.5rem, 4.6vw, 4.2rem);
            font-weight: 700;
            text-transform: uppercase;
            line-height: 1.05;
            letter-spacing: -0.02em;
            color: var(--white);
            text-wrap: balance;
            margin: 0;
        }

        .influencia-hero__highlight {
            color: var(--secondary-light);
        }

        .influencia-hero__description {
            font-size: clamp(1.05rem, 1.3vw, 1.25rem);
            color: rgba(255, 255, 255, 0.85);
            max-width: 700px;
            margin-top: var(--space-md);
            line-height: 1.6;
            text-wrap: pretty;
        }

        .influencia-hero__actions {
            margin-top: var(--space-lg);
            display: flex;
            gap: var(--space-md);
            flex-wrap: wrap;
            align-items: center;
        }

        .influencia-hero__btn-outline {
            border-color: rgba(255, 255, 255, 0.4);
            color: var(--white);
        }

        .influencia-hero__btn-outline:hover {
            border-color: var(--white);
            background: var(--white);
            color: var(--accent-dark);
        }

        @media (max-width: 1100px) {
            .influencia-hero__art {
                opacity: 0.85;
                right: 20px;
                width: 240px;
            }

            .influencia-hero__content {
                max-width: calc(100% - 280px);
            }
        }

        @media (max-width: 768px) {
            .influencia-hero {
                min-height: auto;
                padding: calc(var(--header-height) + var(--space-xl)) 0 var(--space-2xl);
            }

            .influencia-hero__content {
                max-width: 100%;
                text-align: center;
            }

            .influencia-hero__description {
                margin-left: auto;
                margin-right: auto;
            }

            .influencia-hero__actions {
                justify-content: center;
            }

            .influencia-hero__art {
                position: relative;
                top: auto;
                right: auto;
                transform: none;
                width: 220px;
                margin: var(--space-xl) auto var(--space-md);
                display: flex;
            }

            .influencia-phone {
                max-width: 220px;
                transform: none;
            }

            .influencia-phone-glow {
                width: 260px;
                height: 260px;
            }
        }

        /* Estatísticas dentro da Hero (Mesma Cor, Sem Caixa, Números Brancos Flutuantes) */
        .influencia-stats-wrap {
            margin-top: auto;
            padding-top: var(--space-lg);
            padding-bottom: var(--space-xl);
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            position: relative;
            z-index: 2;
        }

        .influencia-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-2xl);
            text-align: center;
        }

        .influencia-stat {
            background: none !important;
            border: none !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            padding: 0 !important;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Efeito de Flutuação nos Números Brancos */
        .influencia-stat--1 .influencia-stat__number {
            animation: float-stat-number 4.8s ease-in-out infinite;
        }

        .influencia-stat--2 .influencia-stat__number {
            animation: float-stat-number 5.4s ease-in-out infinite 0.8s;
        }

        .influencia-stat--3 .influencia-stat__number {
            animation: float-stat-number 4.6s ease-in-out infinite 1.5s;
        }

        @keyframes float-stat-number {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-8px);
            }
        }

        .influencia-stat__number {
            display: inline-block;
            font-family: var(--font-heading);
            font-size: clamp(2.6rem, 4.2vw, 3.8rem);
            font-weight: 700;
            color: #ffffff !important;
            background: none !important;
            -webkit-background-clip: unset !important;
            -webkit-text-fill-color: #ffffff !important;
            text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35), 0 0 24px rgba(208, 143, 255, 0.35);
            line-height: 1;
            letter-spacing: -0.02em;
            will-change: transform;
            transition: transform 0.3s ease;
        }

        .influencia-stat:hover .influencia-stat__number {
            transform: translateY(-10px) scale(1.05);
            text-shadow: 0 6px 24px rgba(0, 0, 0, 0.5), 0 0 35px rgba(208, 143, 255, 0.6);
        }

        .influencia-stat__label {
            display: block;
            margin-top: var(--space-sm);
            font-size: clamp(var(--text-xs), 1vw, var(--text-sm));
            line-height: 1.5;
            color: rgba(255, 255, 255, 0.88);
            max-width: 280px;
            margin-left: auto;
            margin-right: auto;
            font-weight: 500;
        }

        .influencia-stats__sources {
            text-align: center;
            margin-top: var(--space-2xl);
            font-size: var(--text-xs);
            color: rgba(255, 255, 255, 0.45);
        }

        @media (max-width: 768px) {
            .influencia-stats {
                grid-template-columns: 1fr;
                gap: var(--space-xl);
            }

            .influencia-stat__number {
                font-size: 2.5rem;
            }

            .influencia-stats-wrap {
                margin-top: var(--space-xl);
                padding-top: var(--space-xl);
                padding-bottom: var(--space-lg);
            }

            .influencia-stats__sources {
                margin-top: var(--space-lg);
            }
        }

        /* Vídeos de Depoimento & Ação (Transformação Vertical Suave) */
        .video-card {
            background: none;
            border: none;
            box-shadow: none;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            border-radius: 0;
            overflow: visible;
            display: flex;
            flex-direction: column;
            width: 100%;
        }

        .video-card__media {
            position: relative;
            width: 100%;
            aspect-ratio: 16/9;
            background: #0d0314;
            overflow: hidden;
            cursor: pointer;
            border-radius: 18px;
            border: 1px solid rgba(89, 38, 109, 0.12);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            transition: aspect-ratio 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                        box-shadow 0.4s ease,
                        border-color 0.4s ease;
        }

        .video-card:not(.is-playing):hover .video-card__media {
            transform: translateY(-3px);
            border-color: rgba(89, 38, 109, 0.3);
            box-shadow: 0 14px 32px rgba(89, 38, 109, 0.18);
        }

        .video-card.is-playing .video-card__media {
            aspect-ratio: 9/16;
            max-height: min(780px, 82vh);
            max-width: 100%;
            margin: 0 auto;
            border-radius: 18px;
            border: 1px solid rgba(89, 38, 109, 0.2);
            box-shadow: 0 20px 48px rgba(0, 0, 0, 0.25);
        }

        .video-card:not(.is-playing):hover .video-card__poster {
            transform: scale(1.03);
            filter: brightness(0.95);
        }

        .video-card__poster {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease, filter 0.4s ease, opacity 0.4s ease;
        }

        .video-card__player {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
            background: #000;
            border-radius: inherit;
        }

        .video-card.is-playing .video-card__poster,
        .video-card.is-playing .video-card__play-btn {
            opacity: 0;
            pointer-events: none;
            display: none;
        }

        .video-card.is-playing .video-card__player {
            display: block;
        }

        .video-card__close-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: var(--white);
            display: none;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: background 0.3s ease, transform 0.3s ease;
        }

        .video-card.is-playing .video-card__close-btn {
            display: flex;
        }

        .video-card__close-btn:hover {
            background: rgba(0, 0, 0, 0.95);
            transform: scale(1.1);
        }

        .video-card__play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(89, 38, 109, 0.9);
            backdrop-filter: blur(8px);
            border: 2px solid rgba(255, 255, 255, 0.8);
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
            z-index: 2;
        }

        .video-card__play-btn svg {
            margin-left: 2px;
        }

        .video-card:hover .video-card__play-btn {
            transform: translate(-50%, -50%) scale(1.12);
            background: var(--accent);
            box-shadow: 0 0 24px rgba(89, 38, 109, 0.5);
        }

        /* Headers e Títulos Amplos e Horizontais (sem amontoamento) */
        .section__header {
            max-width: 1200px !important;
            width: 100% !important;
            margin-bottom: var(--space-3xl);
        }

        .section__header--center {
            text-align: center;
            margin-left: auto;
            margin-right: auto;
        }

        .section__header .section__title,
        .section__title {
            max-width: 100% !important;
            width: 100% !important;
            margin-left: auto;
            margin-right: auto;
            font-size: clamp(1.75rem, 2.8vw, 2.5rem);
            line-height: 1.2;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

        .section__header .section__description,
        .section__description {
            max-width: 1000px !important;
            width: 100% !important;
            margin-left: auto;
            margin-right: auto;
            font-size: var(--text-base);
            line-height: 1.6;
            text-wrap: balance;
        }

        /* Cases & Resultados (Layout Wide com Todos os Cases e Vídeos) */
        .cases-container {
            max-width: 1380px;
        }

        .influencia-cases-list {
            display: flex;
            flex-direction: column;
            gap: var(--space-3xl);
        }

        .influencia-case-item {
            background: var(--white);
            display: grid;
            grid-template-columns: minmax(380px, 480px) 1fr;
            gap: var(--space-3xl);
            align-items: center;
            padding: var(--space-3xl);
            border-radius: 24px;
            border: 1px solid rgba(89, 38, 109, 0.08);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.03);
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .influencia-case-item:hover {
            border-color: rgba(89, 38, 109, 0.16);
            box-shadow: 0 16px 40px rgba(89, 38, 109, 0.06);
        }

        .influencia-case-item--reverse {
            grid-template-columns: 1fr minmax(380px, 480px);
        }

        .influencia-case-item--reverse .influencia-case-item__media {
            order: 2;
        }

        .influencia-case-item--reverse .influencia-case-item__content {
            order: 1;
        }

        .influencia-case-item__media {
            width: 100%;
        }

        .influencia-case-item__img-wrapper {
            position: relative;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }

        .influencia-case-item__img-wrapper > img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            display: block;
            border-radius: 18px;
            transition: transform 0.5s ease;
        }

        .influencia-case-item:hover .influencia-case-item__img-wrapper > img {
            transform: scale(1.03);
        }

        .influencia-case-item__gallery {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 8px;
        }

        .influencia-case-item__gallery img {
            width: 100%;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid rgba(89, 38, 109, 0.08);
        }

        .influencia-case-item__content {
            display: flex;
            flex-direction: column;
            gap: var(--space-sm);
        }

        .influencia-case-item__tag-row {
            display: flex;
            align-items: center;
            margin-bottom: -2px;
        }

        
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }

        .influencia-case-brand-heading {
            display: flex;
            align-items: center;
            min-height: 46px;
            margin-bottom: 2px;
        }

        .influencia-case-item__logo {
            height: 46px;
            max-height: 52px;
            max-width: 190px;
            width: auto;
            object-fit: contain;
            object-position: left center;
            filter: none;
        }

        .case-item__tag {
            font-size: var(--text-xs);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            background: transparent;
            color: var(--accent);
            padding: 0;
            border-radius: 0;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .case-item__tag::before {
            content: "•";
            font-size: 1.2rem;
            line-height: 0;
            color: var(--accent);
        }

        .influencia-case-item__title {
            font-family: var(--font-heading);
            font-size: clamp(var(--text-xl), 2.2vw, var(--text-2xl));
            font-weight: 700;
            color: var(--text-color);
            margin: 0;
            line-height: 1.2;
        }

        .influencia-case-item__subtitle {
            font-size: var(--text-sm);
            color: var(--text-muted);
            margin-top: -2px;
            font-weight: 500;
        }

        /* Pure Typographic Meta & Quote (Sem caixas ou blocos pesados) */
        .influencia-case-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-xl);
            margin-top: var(--space-xs);
            padding-top: var(--space-sm);
            border-top: 1px solid rgba(89, 38, 109, 0.08);
        }

        .influencia-case-column {
            background: transparent;
            border: none;
            border-radius: 0;
            padding: 0;
        }

        .influencia-case-label {
            display: block;
            color: var(--accent);
            font-size: 0.74rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 4px;
        }

        .influencia-case-text {
            font-size: var(--text-sm);
            color: var(--text-color);
            line-height: 1.5;
            margin: 0;
            opacity: 0.9;
        }

        .influencia-case-quote {
            margin: var(--space-xs) 0 0 0;
            padding: 0 0 0 var(--space-md);
            background: transparent;
            border: none;
            border-left: 2.5px solid var(--accent);
            border-radius: 0;
        }

        .influencia-case-quote__text {
            font-size: 0.90rem;
            color: var(--text-color);
            font-style: italic;
            line-height: 1.55;
            margin: 0;
            opacity: 0.95;
        }

        .influencia-case-quote__author {
            display: block;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--accent);
            font-style: normal;
            margin-top: 6px;
        }

        
        /* Contato & Creators 2 Colunas Lado a Lado */
        .contact-creators-section {
            padding-top: var(--space-2xl) !important;
            padding-bottom: var(--space-3xl) !important;
            position: relative;
        }

        .contact-creators-header {
            margin-bottom: var(--space-2xl) !important;
        }

        .contact-creators-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 36px !important;
            align-items: center !important;
            max-width: 1140px;
            margin: 0 auto;
        }

        .contact-card-col {
            background: #FFFFFF !important;
            border-radius: 28px !important;
            padding: 44px 38px !important;
            box-shadow: 0 16px 44px rgba(0, 0, 0, 0.05), 0 2px 8px rgba(0, 0, 0, 0.03) !important;
            border: 1px solid rgba(0, 0, 0, 0.06) !important;
            display: flex !important;
            flex-direction: column !important;
            justify-content: center !important;
            box-sizing: border-box !important;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .contact-card-col:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08) !important;
        }

        .influencia-form-clean {
            display: flex;
            flex-direction: column;
            gap: 16px;
            background: transparent !important;
            padding: 0 !important;
        }

        .form-group-clean {
            display: flex;
            flex-direction: column;
            gap: 6px;
            text-align: left;
        }

        .form-group-clean label {
            font-family: var(--font-heading);
            font-size: 0.88rem;
            font-weight: 600;
            color: #1e1e24;
            letter-spacing: -0.01em;
        }

        .form-group-clean input,
        .form-group-clean select {
            width: 100%;
            box-sizing: border-box;
            padding: 13px 16px;
            font-size: 0.95rem;
            background: #FAFAFB;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            color: #1e1e24;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-group-clean input:focus,
        .form-group-clean select:focus {
            background: #FFFFFF;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(85, 27, 107, 0.12);
        }

        .btn--submit-brand {
            margin-top: 6px;
            padding: 15px 24px;
            font-family: var(--font-heading);
            font-size: 1rem;
            font-weight: 700;
            background: var(--accent);
            color: var(--white);
            border-radius: 12px;
            border: none;
            cursor: pointer;
            transition: all 0.25s ease;
            width: 100%;
        }

        .btn--submit-brand:hover {
            background: var(--accent-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(85, 27, 107, 0.25);
        }

        /* Coluna Direita (Creators - Visual Moderno, Efeito Glow & Espaçamento) */
        .creators-card-col {
            background: radial-gradient(ellipse 90% 70% at 85% 15%, rgba(192, 132, 252, 0.16) 0%, transparent 65%),
                        linear-gradient(145deg, #2d0c3c 0%, #15031f 100%) !important;
            border-radius: 28px !important;
            padding: 52px 42px !important;
            box-shadow: 0 20px 50px rgba(22, 4, 32, 0.35), 0 0 35px rgba(168, 85, 247, 0.08) !important;
            border: 1px solid rgba(216, 160, 255, 0.22) !important;
            color: #FFFFFF !important;
            display: flex !important;
            flex-direction: column !important;
            justify-content: center !important;
            box-sizing: border-box !important;
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .creators-card-col:hover {
            transform: translateY(-3px);
            border-color: rgba(216, 160, 255, 0.45) !important;
            box-shadow: 0 26px 60px rgba(22, 4, 32, 0.45), 0 0 45px rgba(168, 85, 247, 0.18) !important;
        }

        .creators-card-col::before {
            content: '';
            position: absolute;
            top: -40px;
            right: -40px;
            width: 180px;
            height: 180px;
            background: radial-gradient(circle, rgba(208, 143, 255, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
            filter: blur(25px);
        }

        .creators-card-inner {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            text-align: left;
            position: relative;
            z-index: 2;
        }

        .creators-card__title {
            font-family: var(--font-heading);
            font-size: clamp(1.45rem, 2.1vw, 1.85rem);
            font-weight: 700;
            color: #FFFFFF;
            margin: 0 0 16px 0;
            line-height: 1.25;
            text-align: left;
            letter-spacing: -0.01em;
        }

        .creators-card__text {
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.88);
            line-height: 1.65;
            margin: 0 0 32px 0;
            text-align: left;
        }

        .btn--creator-cta {
            display: inline-block;
            width: 100%;
            box-sizing: border-box;
            padding: 16px 24px;
            background: linear-gradient(135deg, #74278d 0%, #4a155c 100%);
            color: #FFFFFF;
            border: 1px solid rgba(216, 160, 255, 0.35);
            border-radius: 12px;
            font-family: var(--font-heading);
            font-size: 0.95rem;
            font-weight: 700;
            text-align: center;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 6px 20px rgba(74, 21, 92, 0.3);
        }

        .btn--creator-cta:hover {
            background: linear-gradient(135deg, #882fa5 0%, #5b1b71 100%);
            border-color: rgba(233, 213, 255, 0.65);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(116, 39, 141, 0.45);
            color: #FFFFFF;
        }

        /* Espaçamento do FAQ */
        #faq.section {
            padding-top: var(--space-3xl) !important;
            padding-bottom: var(--space-3xl) !important;
        }

        #faq .section__header {
            margin-bottom: var(--space-xl) !important;
        }

        @media (max-width: 900px) {
            .contact-creators-grid {
                grid-template-columns: 1fr !important;
                gap: 24px !important;
            }
            .contact-card-col,
            .creators-card-col {
                padding: 36px 24px !important;
                border-radius: 22px !important;
            }
            .creators-card__text {
                margin-bottom: 24px !important;
            }
            .btn--creator-cta {
                font-size: 0.9rem;
                padding: 14px 20px;
            }
        }

        /* Chamada para Influenciadores */
        .creators-callout-section {
            padding-top: var(--space-2xl);
            padding-bottom: var(--space-2xl);
        }

        .creators-callout {
            padding: var(--space-3xl) var(--space-2xl);
            text-align: center;
            border-radius: 24px;
            background: linear-gradient(135deg, #3d144e 0%, #1c0828 100%);
            border: 1px solid rgba(208, 143, 255, 0.35);
            box-shadow: 0 24px 48px rgba(30, 10, 42, 0.35);
            color: var(--white);
        }

        .creators-callout .section__tag {
            color: var(--secondary-light);
            background: rgba(208, 143, 255, 0.15);
            border: 1px solid rgba(208, 143, 255, 0.3);
            display: inline-block;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: var(--text-xs);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .creators-callout__title {
            font-family: var(--font-heading);
            font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
            color: var(--white);
            max-width: 720px;
            margin: var(--space-md) auto var(--space-sm);
            line-height: 1.25;
            font-weight: 700;
        }

        .creators-callout__text {
            font-size: var(--text-base);
            color: rgba(255, 255, 255, 0.88);
            max-width: 640px;
            margin: 0 auto var(--space-xl);
            line-height: 1.6;
        }

        /* Seletor de Cases (Pills / Tabs no Mobile) */
        .influencia-cases-tabs {
            display: none;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: var(--space-lg);
            width: 100%;
        }

        .influencia-case-tab {
            background: #ffffff;
            border: 1.5px solid rgba(89, 38, 109, 0.12);
            border-radius: 14px;
            padding: 10px 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
        }

        .influencia-case-tab__name {
            font-family: var(--font-heading);
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-color);
            line-height: 1.1;
        }

        .influencia-case-tab__sub {
            font-size: 0.68rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .influencia-case-tab.is-active {
            background: var(--accent);
            border-color: var(--accent);
            box-shadow: 0 6px 18px rgba(89, 38, 109, 0.28);
        }

        .influencia-case-tab.is-active .influencia-case-tab__name {
            color: #ffffff;
        }

        .influencia-case-tab.is-active .influencia-case-tab__sub {
            color: rgba(255, 255, 255, 0.85);
        }

        .influencia-case-mobile-nav {
            display: none;
            margin-top: var(--space-xs);
            padding-top: var(--space-xs);
            border-top: 1px solid rgba(89, 38, 109, 0.08);
            gap: 8px;
        }

        .influencia-case-nav-btn {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background: rgba(89, 38, 109, 0.06);
            border: 1px solid rgba(89, 38, 109, 0.12);
            color: var(--accent);
            font-family: var(--font-heading);
            font-size: 0.78rem;
            font-weight: 700;
            padding: 9px 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .influencia-case-nav-btn:hover {
            background: var(--accent);
            color: #ffffff;
        }

        @keyframes fadeInCase {
            from {
                opacity: 0;
                transform: translateY(6px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 900px) {
            .influencia-cases-tabs {
                display: grid;
            }

            .influencia-cases-list {
                gap: 0;
            }

            .influencia-case-item {
                display: none;
                animation: fadeInCase 0.35s ease forwards;
                grid-template-columns: 1fr;
                gap: var(--space-md);
                padding: var(--space-lg);
            }

            .influencia-case-item.is-active {
                display: flex;
                flex-direction: column;
            }

            .influencia-case-mobile-nav {
                display: flex;
            }

            .influencia-case-item--reverse .influencia-case-item__media {
                order: 1;
            }

            .influencia-case-item--reverse .influencia-case-item__content {
                order: 2;
            }

            .influencia-case-item__img-wrapper > img {
                height: 180px;
            }
        }

        @media (max-width: 640px) {
            .influencia-cases-tabs {
                gap: 6px;
                margin-bottom: var(--space-md);
            }

            .influencia-case-tab {
                padding: 8px 6px;
                border-radius: 10px;
            }

            .influencia-case-tab__name {
                font-size: 0.80rem;
            }

            .influencia-case-tab__sub {
                font-size: 0.62rem;
            }

            .influencia-case-item,
            .influencia-case-item--reverse {
                padding: 12px;
                border-radius: 14px;
                gap: 8px;
            }

            .video-card:not(.is-playing) .video-card__media {
                height: 140px;
                aspect-ratio: 16/9;
                border-radius: 10px;
            }

            .video-card__play-btn {
                width: 44px;
                height: 44px;
            }

            .influencia-case-item__img-wrapper > img {
                height: 140px;
                border-radius: 10px;
            }

            .influencia-case-item__gallery {
                display: none;
            }

            .influencia-case-item__tag-row {
                margin-bottom: -2px;
            }

            
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }

        .influencia-case-brand-heading {
                min-height: 38px;
            }

            .influencia-case-item__logo {
                height: 36px;
                max-height: 40px;
                max-width: 150px;
                object-fit: contain;
                object-position: left center;
            }

            .influencia-case-item__title {
                font-size: 1.15rem;
                margin: 0;
            }

            .influencia-case-item__subtitle {
                font-size: 0.78rem;
                margin-top: -3px;
            }

            .influencia-case-meta {
                display: flex;
                flex-direction: column;
                gap: 6px;
                background: transparent;
                border: none;
                border-top: 1px solid rgba(89, 38, 109, 0.08);
                border-radius: 0;
                padding: 6px 0 0 0;
            }

            .influencia-case-column {
                background: none;
                border: none;
                padding: 0;
            }

            .influencia-case-label {
                font-size: 0.66rem;
                margin-bottom: 2px;
                font-weight: 800;
            }

            .influencia-case-text {
                font-size: 0.80rem;
                line-height: 1.35;
            }

            .influencia-case-quote {
                background: transparent;
                border: none;
                border-left: 2px solid var(--accent);
                border-radius: 0;
                padding: 0 0 0 8px;
                margin-top: 4px;
            }

            .influencia-case-quote__text {
                font-size: 0.78rem;
                line-height: 1.35;
            }

            .influencia-case-quote__author {
                font-size: 0.68rem;
                margin-top: 3px;
                font-weight: 700;
            }

            .influencia-case-mobile-nav {
                margin-top: 4px;
                padding-top: 6px;
                gap: 6px;
            }

            .influencia-case-nav-btn {
                padding: 7px 10px;
                font-size: 0.72rem;
            }
        }

        /* CTA banner intermediário */
        .influencia-cta-banner {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, var(--accent-dark), #2a0f3a);
            padding: var(--space-3xl) 0;
            text-align: center;
        }

        .influencia-cta-banner::before,
        .influencia-cta-banner::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(208, 143, 255, 0.35), transparent 70%);
            pointer-events: none;
        }

        .influencia-cta-banner::before {
            width: 360px;
            height: 360px;
            top: -180px;
            left: -100px;
        }

        .influencia-cta-banner::after {
            width: 280px;
            height: 280px;
            bottom: -160px;
            right: -80px;
        }

        .influencia-cta-banner .container {
            position: relative;
            z-index: 1;
        }

        .influencia-cta-banner__title {
            font-family: var(--font-heading);
            font-size: clamp(var(--text-2xl), 3.5vw, var(--text-4xl));
            color: var(--white);
            margin-bottom: var(--space-lg);
        }
    </style>

    <script src="/script.js" is:inline></script>

    <!-- Envio do formulário via Web3Forms (AJAX, sem recarregar a página) -->
    <script is:inline>
      (function () {
        const form = document.getElementById('influencia-form');
        if (!form) return;
        const status = document.getElementById('influencia-form-status');
        const button = form.querySelector('button[type="submit"]');
        const buttonLabel = button ? button.innerHTML : '';
        const whatsappUrl = 'https://api.whatsapp.com/send?l=pt_BR&phone=5516992558698&text=Ol%C3%A1!%20Vim%20da%20p%C3%A1gina%20de%20Marketing%20de%20Influ%C3%AAncia%20e%20quero%20uma%20proposta.';

        function showStatus(message, isError) {
          if (!status) return;
          status.innerHTML = message;
          status.style.display = 'block';
          status.style.background = isError ? 'rgba(229, 57, 53, 0.12)' : 'rgba(67, 160, 71, 0.12)';
          status.style.color = isError ? '#c62828' : '#2e7d32';
          status.style.border = '1px solid ' + (isError ? 'rgba(229, 57, 53, 0.4)' : 'rgba(67, 160, 71, 0.4)');
        }

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          const honeypot = form.querySelector('input[name="b_website"]');
          if (honeypot && honeypot.value) return;

          if (button) {
            button.disabled = true;
            button.innerHTML = 'Enviando...';
          }
          if (status) status.style.display = 'none';

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: new FormData(form),
            });
            const data = await response.json();

            if (response.ok && data.success) {
              showStatus('✅ Proposta solicitada! Em breve entraremos em contato.', false);
              form.reset();

              if (typeof window !== 'undefined') {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                  event: 'generate_lead',
                  form_name: 'lp_marketing_influencia'
                });
                if (window.gtag) {
                  window.gtag('event', 'generate_lead', {
                    event_category: 'Formulário',
                    event_label: 'LP Marketing de Influência',
                    value: 1
                  });
                }
                if (window.fbq) {
                  window.fbq('track', 'Lead', {
                    content_name: 'LP Marketing de Influência',
                    value: 1,
                    currency: 'BRL'
                  });
                }
              }
            } else {
              showStatus(
                '❌ Não foi possível enviar agora. Fale com a gente pelo <a href="' +
                  whatsappUrl +
                  '" target="_blank" style="color: inherit; text-decoration: underline;">WhatsApp</a>.',
                true
              );
            }
          } catch (error) {
            showStatus(
              '❌ Erro de conexão. Tente novamente ou fale pelo <a href="' +
                whatsappUrl +
                '" target="_blank" style="color: inherit; text-decoration: underline;">WhatsApp</a>.',
              true
            );
          } finally {
            if (button) {
              button.disabled = false;
              button.innerHTML = buttonLabel;
            }
          }
        });

        // Video card vertical playback controller
        const videoCards = document.querySelectorAll('.video-card');
        videoCards.forEach((card) => {
          const media = card.querySelector('.video-card__media');
          const playBtn = card.querySelector('.video-card__play-btn');
          const closeBtn = card.querySelector('.video-card__close-btn');
          const video = card.querySelector('.video-card__player');
          if (!media || !video) return;

          const openVerticalVideo = () => {
            // Pause any other active video cards
            videoCards.forEach((otherCard) => {
              if (otherCard !== card && otherCard.classList.contains('is-playing')) {
                const otherVid = otherCard.querySelector('.video-card__player');
                if (otherVid) otherVid.pause();
                otherCard.classList.remove('is-playing');
              }
            });

            if (!card.classList.contains('is-playing')) {
              card.classList.add('is-playing');
              video.currentTime = 0;
              video.play().catch(() => {});

              // Smoothly accompany the video into center view
              setTimeout(() => {
                const caseItem = card.closest('.influencia-case-item') || card;
                caseItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }, 120);
            }
          };

          const closeVerticalVideo = () => {
            card.classList.remove('is-playing');
            video.pause();

            setTimeout(() => {
              const caseItem = card.closest('.influencia-case-item') || card;
              caseItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 80);
          };

          if (playBtn) {
            playBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              openVerticalVideo();
            });
          }

          media.addEventListener('click', (e) => {
            if (e.target.closest('.video-card__close-btn')) {
              e.stopPropagation();
              closeVerticalVideo();
              return;
            }
            if (!card.classList.contains('is-playing')) {
              openVerticalVideo();
            }
          });

          if (closeBtn) {
            closeBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              closeVerticalVideo();
            });
          }

          video.addEventListener('ended', () => {
            closeVerticalVideo();
          });
        });

        // Case tabs switcher para mobile e tablet
        const caseTabs = document.querySelectorAll('.influencia-case-tab');
        const caseItems = document.querySelectorAll('.influencia-case-item');
        const navBtns = document.querySelectorAll('.influencia-case-nav-btn');

        function activateCase(index) {
          const idx = Number(index);
          caseTabs.forEach((tab) => {
            const isActive = Number(tab.dataset.caseTarget) === idx;
            tab.classList.toggle('is-active', isActive);
            tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          caseItems.forEach((item) => {
            const isActive = Number(item.dataset.caseIndex) === idx;
            item.classList.toggle('is-active', isActive);
          });

          if (window.innerWidth <= 900) {
            const activeCard = document.querySelector('.influencia-case-item[data-case-index="' + idx + '"]');
            if (activeCard) {
              activeCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }
        }

        caseTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            activateCase(tab.dataset.caseTarget);
          });
        });

        navBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            if (btn.dataset.nextCase !== undefined) {
              activateCase(btn.dataset.nextCase);
            }
          });
        });
      })();
    </script>
</body>

</html>
