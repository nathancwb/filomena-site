---
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import AnalyticsNoscript from '../components/AnalyticsNoscript.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <Analytics />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="alternate" type="text/markdown" href="/404.md" />
    <meta name="robots" content="noindex, follow" />
    <title>Página não encontrada | Filomena Propaganda</title>
    <meta name="description" content="A página que você procura não existe ou foi movida. Acesse nosso mapa do site ou as principais seções da Filomena Propaganda.">
    
    <!-- Organization Schema -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "AdvertisingAgency"],
      "name": "Filomena Propaganda",
      "url": "https://www.filomenapropaganda.com.br",
      "telephone": "+551634154110",
      "email": "contato@filomenapropaganda.com.br"
    }
    </script>
    <link rel="preload" href="/assets/fonts/OliviarSans-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .error-page {
            min-height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 6rem 1.5rem;
        }
        .error-page__code {
            font-family: var(--font-heading);
            font-weight: 900;
            font-size: clamp(5rem, 18vw, 12rem);
            line-height: 1;
            color: var(--accent);
            letter-spacing: -0.04em;
        }
        .error-page__title {
            font-family: var(--font-heading);
            font-size: clamp(1.5rem, 4vw, 2.25rem);
            font-weight: 700;
            margin: 1rem 0 0.75rem;
        }
        .error-page__text {
            color: var(--text-muted);
            max-width: 540px;
            margin: 0 auto 2rem;
            line-height: 1.7;
        }
        .error-page__actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 2.5rem;
        }
        .error-page__recovery {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
            border-radius: var(--radius-md, 12px);
            padding: 1.5rem;
            max-width: 580px;
            margin: 0 auto;
            text-align: left;
        }
        .error-page__recovery h2 {
            font-size: 1.1rem;
            margin-bottom: 0.75rem;
            color: var(--text-heading, #fff);
        }
        .error-page__recovery-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 0.5rem 1rem;
            list-style: none;
            padding: 0;
            margin: 0;
            font-size: 0.9rem;
        }
        .error-page__recovery-links a {
            color: var(--secondary, #8053ff);
            text-decoration: underline;
            text-underline-offset: 3px;
        }
    </style>
</head>

<body>
    <AnalyticsNoscript />
    <div class="noise-overlay"></div>
    <header class="header">
        <div class="header__inner container">
            <a href="/" class="logo">
                <img src="/assets/images/logo-main.webp" alt="Filomena Propaganda & Marketing" class="logo__img" width="220" height="50" loading="eager" />
            </a>
            <nav class="nav">
                <ul class="nav__list" id="nav-menu">
                    <li><a href="/" class="nav__link">Home</a></li>
                    <li><a href="/sobre/" class="nav__link">Sobre</a></li>
                    <li><a href="/servicos/" class="nav__link">Serviços</a></li>
                    <li><a href="/portfolio/" class="nav__link">Portfólio</a></li>
                    <li><a href="/blog/" class="nav__link">Blog</a></li>
                    <li><a href="/trabalhe-conosco/" class="nav__link">Trabalhe Conosco</a></li>
                    <li><a href="/contato/" class="nav__link">Contato</a></li>
                </ul>
                <div class="nav__actions">
                    <button class="menu-toggle" id="menu-toggle" aria-label="Menu">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <section class="error-page">
            <div>
                <div class="error-page__code">404</div>
                <h1 class="error-page__title">Página não encontrada</h1>
                <p class="error-page__text">
                    O endereço que você acessou não existe ou foi movido. Use os links abaixo para navegar pelos recursos oficiais da Filomena Propaganda.
                </p>
                <div class="error-page__actions">
                    <a href="/" class="btn btn--primary">Voltar para a Home</a>
                    <a href="/contato/" class="btn btn--outline">Falar com a gente</a>
                </div>
                <div class="error-page__recovery">
                    <h2>Recursos e Mapa de Navegação:</h2>
                    <ul class="error-page__recovery-links">
                        <li><a href="/">• Página Inicial</a></li>
                        <li><a href="/sobre/">• Sobre a Agência</a></li>
                        <li><a href="/servicos/">• Serviços</a></li>
                        <li><a href="/portfolio/">• Portfólio de Cases</a></li>
                        <li><a href="/blog/">• Artigos do Blog</a></li>
                        <li><a href="/contato/">• Contato & Orçamento</a></li>
                        <li><a href="/privacidade/">• Política de Privacidade</a></li>
                        <li><a href="/llms.txt">• LLMs Index (llms.txt)</a></li>
                        <li><a href="/sitemap-index.xml">• Mapa do Site (XML)</a></li>
                    </ul>
                </div>
            </div>
        </section>
    </main>

    <Footer />
    <script src="/script.js" is:inline></script>
</body>

</html>
