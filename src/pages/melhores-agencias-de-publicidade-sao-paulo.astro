        .criteria-card__header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }
        .criteria-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            background: var(--accent);
            color: white;
            border-radius: 50%;
            font-weight: 700;
            font-size: 0.9rem;
        }
        .criteria-card h3 {
            margin: 0;
            font-size: 1.3rem;
        }
        .criteria-block {
            margin-top: 1.25rem;
            padding: 1rem 1.25rem;
            border-radius: 8px;
            font-size: 0.98rem;
            line-height: 1.6;
        }
        .criteria-block--alert {
            background: rgba(220, 53, 69, 0.08);
            border-left: 3px solid #dc3545;
            color: #842029;
