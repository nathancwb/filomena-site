---
import { getCollection, render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Get next project for bottom link
const allProjects = await getCollection('portfolio');
const currentIndex = allProjects.findIndex(p => p.id === project.id);
const nextProject = allProjects[(currentIndex + 1) % allProjects.length];
---
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={project.data.description}>
    <title>{project.data.title} | Filomena Propaganda</title>
    <link rel="canonical" href={`https://www.filomenapropaganda.com.br/portfolio/${project.id}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${project.data.title} | Filomena Propaganda`} />
    <meta property="og:description" content={project.data.description} />
    <meta property="og:url" content={`https://www.filomenapropaganda.com.br/portfolio/${project.id}/`} />
    <meta property="og:image" content={`https://www.filomenapropaganda.com.br${project.data.thumbnail}`} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`https://www.filomenapropaganda.com.br${project.data.thumbnail}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">

    <style>
        /* =========================================
           PORTFOLIO CASE STUDY - PREMIUM DESIGN
        ========================================= */

        .case-header {
            padding: 8rem 0 3rem;
            text-align: left;
            position: relative;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            color: var(--accent-light);
            text-decoration: none;
            transition: transform var(--transition), color var(--transition);
            margin-bottom: 2rem;
            font-family: var(--font-heading);
            font-size: var(--text-sm);
        }

        .back-link:hover {
            color: var(--accent);
            transform: translateX(-4px);
        }

        .case-tag {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--accent);
            margin-bottom: 1rem;
            display: block;
        }

        .case-title {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 2rem;
            letter-spacing: -0.03em;
            color: var(--black);
            font-family: var(--font-heading);
        }

        /* Brief Grid Info */
        .case-meta-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--space-xl);
            padding: var(--space-xl) 0;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            margin-bottom: 4rem;
        }

        @media (max-width: 768px) {
            .case-meta-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: var(--space-lg);
            }
        }

        .meta-item__label {
            font-size: var(--text-xs);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--gray-500);
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .meta-item__value {
            font-size: var(--text-base);
            font-weight: 700;
            color: var(--black);
        }

        /* Main Section Content */
        .case-content-wrapper {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: var(--space-4xl);
            margin-bottom: 5rem;
            align-items: start;
        }

        @media (max-width: 968px) {
            .case-content-wrapper {
                grid-template-columns: 1fr;
                gap: var(--space-2xl);
            }
        }

        .case-story {
            font-size: 1.15rem;
            line-height: 1.8;
            color: var(--text-muted);
        }

        .case-story h2, .case-story h3 {
            font-family: var(--font-heading);
            color: var(--black);
            font-weight: 800;
            margin: 2.5rem 0 1rem;
            line-height: 1.2;
        }

        .case-story h2 { font-size: 1.8rem; }
        .case-story h3 { font-size: 1.4rem; }

        .case-story p {
            margin-bottom: 1.5rem;
        }

        /* Stats Card Section */
        .case-stats-panel {
            background: var(--bg-alt);
            padding: var(--space-2xl);
            border-radius: 24px;
            border: 1px solid var(--border);
        }

        .case-stats-panel__title {
            font-family: var(--font-heading);
            font-size: var(--text-lg);
            font-weight: 700;
            color: var(--black);
            margin-bottom: var(--space-xl);
            border-bottom: 2px solid var(--border);
            padding-bottom: var(--space-sm);
        }

        .stats-grid {
            display: flex;
            flex-direction: column;
            gap: var(--space-lg);
        }

        .stat-card-item {
            display: flex;
            flex-direction: column;
        }

        .stat-card-item__value {
            font-family: var(--font-heading);
            font-size: var(--text-2xl);
            font-weight: 900;
            color: var(--accent);
            line-height: 1.1;
        }

        .stat-card-item__label {
            font-size: var(--text-sm);
            color: var(--text-muted);
            font-weight: 500;
            margin-top: 0.25rem;
        }

        /* Visual Showcase Section */
        .showcase-section {
            padding: 4rem 0 6rem;
            background: var(--bg-alt);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .showcase-title {
            font-family: var(--font-heading);
            font-size: var(--text-3xl);
            font-weight: 800;
            color: var(--black);
            margin-bottom: 3rem;
            text-align: center;
        }

        .showcase-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .showcase-image-wrapper {
            width: 100%;
            height: 100%;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--shadow-md);
            background: var(--white);
            border: 1px solid var(--border);
            transition: transform var(--transition), box-shadow var(--transition);
            display: flex;
        }

        .showcase-image-wrapper:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

        .showcase-image-wrapper img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }
        
        /* Bento logic: The first image is large, the rest are side-by-side, 
           with occasional large images to break the pattern */
        .showcase-image-wrapper:first-child {
            grid-column: 1 / -1;
        }
        
        .showcase-image-wrapper:nth-child(3n+4) {
            grid-column: 1 / -1;
        }

        /* Video Showcase */
        .showcase-video-wrapper {
            width: 100%;
            grid-column: 1 / -1;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border);
            background: var(--black);
        }

        .showcase-video-wrapper video {
            width: 100%;
            height: auto;
            display: block;
        }

        @media (max-width: 768px) {
            .showcase-grid {
                grid-template-columns: 1fr;
            }
            .showcase-image-wrapper:first-child,
            .showcase-image-wrapper:nth-child(3n+4) {
                grid-column: 1 / -1;
            }
        }

        /* Next Case Footer Nav */
        .next-case-nav {
            padding: 6rem 0;
            background: var(--white);
            text-align: center;
        }

        .next-case-nav__label {
            font-size: var(--text-xs);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--gray-500);
            margin-bottom: 1rem;
            display: block;
        }

        .next-case-nav__link {
            font-family: var(--font-heading);
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 900;
            color: var(--black);
            text-decoration: none;
            transition: color var(--transition), transform var(--transition);
            display: inline-flex;
            align-items: center;
            gap: var(--space-md);
        }

        .next-case-nav__link svg {
            transition: transform var(--transition);
        }

        .next-case-nav__link:hover {
            color: var(--accent);
        }

        .next-case-nav__link:hover svg {
            transform: translateX(10px);
        }
    </style>
</head>

<body>
    <div class="noise-overlay"></div>

    <!-- Header -->
    <header class="header">
        <div class="header__inner container">
            <a href="/" class="logo">
                <img src="/assets/images/logo-main.webp" alt="Filomena Propaganda & Marketing" class="logo__img">
            </a>

            <nav class="nav">
                <ul class="nav__list" id="nav-menu">
                    <li><a href="/" class="nav__link">Home</a></li>
                    <li><a href="/sobre/" class="nav__link">Sobre</a></li>
                    <li><a href="/servicos/" class="nav__link">Serviços</a></li>
                    <li><a href="/portfolio/" class="nav__link active">Portfólio</a></li>
                    <li><a href="/blog/" class="nav__link">Blog</a></li>
                    <li><a href="/trabalhe-conosco/" class="nav__link">Trabalhe Conosco</a></li>
                    <li><a href="/contato/" class="nav__link">Contato</a></li>
                </ul>

                <div class="nav__actions">
                    <button class="menu-toggle" id="menu-toggle" aria-label="Menu">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <!-- Case Header -->
        <section class="case-header">
            <div class="container">
                <a href="/portfolio/" class="back-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
                    Voltar para o Portfólio
                </a>
                <span class="case-tag fade-in">{project.data.category}</span>
                <h1 class="case-title fade-in">{project.data.client}</h1>
            </div>
        </section>

        <!-- Brief Grid Info -->
        <section class="container">
            <div class="case-meta-grid fade-in">
                <div class="meta-item">
                    <p class="meta-item__label">Cliente</p>
                    <p class="meta-item__value">{project.data.client}</p>
                </div>
                <div class="meta-item">
                    <p class="meta-item__label">Categoria</p>
                    <p class="meta-item__value">{project.data.category}</p>
                </div>
                <div class="meta-item">
                    <p class="meta-item__label">Ano do Projeto</p>
                    <p class="meta-item__value">2025</p>
                </div>
                <div class="meta-item">
                    <p class="meta-item__label">Agência</p>
                    <p class="meta-item__value">Filomena Propaganda</p>
                </div>
            </div>
        </section>

        <!-- Main Content Wrapper -->
        <section class="container">
            <div class="case-content-wrapper">
                <!-- Case Story -->
                <div class="case-story fade-in">
                    <Content />
                </div>

                <!-- Case Stats / Summary -->
                {project.data.stats && (
                    <div class="case-stats-panel fade-in">
                        <h3 class="case-stats-panel__title">Destaques do Case</h3>
                        <div class="stats-grid">
                            {project.data.stats.map(stat => (
                                <div class="stat-card-item">
                                    <span class="stat-card-item__value">{stat.value}</span>
                                    <span class="stat-card-item__label">{stat.label}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                )}
            </div>
        </section>

        <!-- Visual Showcase Section -->
        {((project.data.images && project.data.images.length > 0) || project.data.video) && (
            <section class="showcase-section">
                <div class="container">
                    <h2 class="showcase-title fade-in">Showcase do Projeto</h2>
                    
                    <div class="showcase-grid">
                        <!-- Render Loop Video if Available -->
                        {project.data.video && (
                            <div class="showcase-video-wrapper fade-in">
                                <video autoplay loop muted playsinline controls>
                                    <source src={project.data.video} type="video/mp4" />
                                    Seu navegador não suporta vídeos HTML5.
                                </video>
                            </div>
                        )}

                        <!-- Render Images List -->
                        {project.data.images && project.data.images.map(image => (
                            <div class="showcase-image-wrapper fade-in">
                                <img src={image} alt={project.data.client} loading="lazy" decoding="async" />
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        )}

        <!-- Next Case Navigation -->
        {nextProject && (
            <section class="next-case-nav">
                <div class="container">
                    <span class="next-case-nav__label">Ver Próximo Case</span>
                    <a href={`/portfolio/${nextProject.id}/`} class="next-case-nav__link">
                        {nextProject.data.client}
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
                    </a>
                </div>
            </section>
        )}
    </main>

    <!-- Footer -->
    <Footer />

    <!-- WhatsApp Floating Button -->
    <a href="https://api.whatsapp.com/send?l=pt_BR&phone=551634154110" class="whatsapp-btn" target="_blank" aria-label="WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
    </a>

    <script src="/script.js" is:inline></script>
</body>

</html>
