---
// Componente Modal de Captação de Lead (Diagnóstico Estratégico - Fluxo Otimizado)
---

<!-- Modal Overlay -->
<div class="lead-modal-overlay js-lead-modal" id="leadWizardModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="leadModalTitle">
    <div class="lead-modal-backdrop js-lead-modal-close" tabindex="-1"></div>
    
    <div class="lead-modal-container">
        <!-- Botão Fechar -->
        <button type="button" class="lead-modal-close js-lead-modal-close" aria-label="Fechar diagnóstico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <!-- Header / Badge -->
        <div class="lead-modal-header">
            <span class="lead-modal-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
                Diagnóstico Estratégico Gratuito
            </span>
        </div>

        <!-- FORM WIZARD -->
        <form class="lead-modal-form js-lead-form" id="leadWizardForm" novalidate>
            <!-- Barra de Progresso -->
            <div class="lead-progress-wrapper" aria-label="Progresso do formulário">
                <div class="lead-progress-track">
                    <span class="lead-progress-bar js-step-progress" style="width: 25%;"></span>
                </div>
                <div class="lead-progress-meta">
                    <span class="lead-progress-step-text js-step-indicator">Etapa 1 de 4</span>
                    <span class="lead-progress-pct js-step-pct">25%</span>
                </div>
            </div>

            <!-- ETAPA 1: Objetivo Principal da Marca -->
            <div class="lead-step active" data-step="1">
                <div class="lead-step-heading">
                    <span class="lead-step-num">1</span>
                    <div>
                        <span class="lead-step-kicker">Objetivo Estratégico</span>
                        <h3 class="lead-step-title" id="leadModalTitle">Qual é a maior prioridade da sua marca hoje?</h3>
                    </div>
                </div>
                <div class="lead-quiz-cards">
                    <label class="lead-quiz-card">
                        <input type="radio" name="servico_prioritario" value="Branding e Posicionamento" required />
                        <span class="lead-card-key">A</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Branding & Identidade Visual</strong>
                            <span class="lead-card-desc">Construir ou reformular logotipo, manual de marca e posicionamento de valor</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="servico_prioritario" value="Tráfego Pago e Vendas" />
                        <span class="lead-card-key">B</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Tráfego Pago & Performance (Google/Meta Ads)</strong>
                            <span class="lead-card-desc">Anúncios focados em gerar leads qualificados e acelerar o faturamento</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="servico_prioritario" value="Assessoria Completa 360" />
                        <span class="lead-card-key">C</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Assessoria Completa de Marketing (360°)</strong>
                            <span class="lead-card-desc">Planejamento, redes sociais, criativos, anúncios e time estratégico dedicado</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="servico_prioritario" value="Criacao de Site ou Landing Page" />
                        <span class="lead-card-key">D</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Criação de Site / Landing Page</strong>
                            <span class="lead-card-desc">Desenvolvimento de página moderna, veloz e otimizada para alta conversão</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>
                </div>
                <p class="lead-step-error" id="error-step-1" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-primary lead-btn-next" data-next-step="2">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- ETAPA 2: Principais Gargalos Atuais (Multi-select) -->
            <div class="lead-step" data-step="2" hidden>
                <div class="lead-step-heading">
                    <span class="lead-step-num">2</span>
                    <div>
                        <span class="lead-step-kicker">Diagnóstico de Desafios</span>
                        <h3 class="lead-step-title">Quais gargalos você mais precisa resolver hoje?</h3>
                        <p class="lead-step-subtext">Selecione uma ou mais opções:</p>
                    </div>
                </div>
                <div class="lead-quiz-cards">
                    <label class="lead-quiz-card lead-card-checkbox">
                        <input type="checkbox" name="desafios" value="Poucos leads ou vendas travadas" />
                        <span class="lead-card-key">A</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Poucos leads qualificados ou vendas estagnadas</strong>
                            <span class="lead-card-desc">Dificuldade em manter um fluxo previsível e diário de novos clientes</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card lead-card-checkbox">
                        <input type="checkbox" name="desafios" value="Marca desvalorizada / guerra de precos" />
                        <span class="lead-card-key">B</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Marca pouco valorizada / Guerra de preços</strong>
                            <span class="lead-card-desc">Clientes comparam seu negócio apenas por preço em vez de reconhecer valor</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card lead-card-checkbox">
                        <input type="checkbox" name="desafios" value="Anuncios com pouco retorno ou CAC alto" />
                        <span class="lead-card-key">C</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Anúncios sem retorno / Custo por lead alto</strong>
                            <span class="lead-card-desc">Investimento em tráfego sem clareza de retorno sobre o investimento (ROAS)</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card lead-card-checkbox">
                        <input type="checkbox" name="desafios" value="Falta de equipe e consistencia de marketing" />
                        <span class="lead-card-key">D</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Falta de equipe e consistência na comunicação</strong>
                            <span class="lead-card-desc">Redes sociais desatualizadas e falta de braço técnico para executar</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>
                </div>
                <p class="lead-step-error" id="error-step-2" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-back" data-previous-step="1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        Voltar
                    </button>
                    <button type="button" class="lead-btn-primary lead-btn-next" data-next-step="3">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- ETAPA 3: Qualificação de Budget (Investimento com Agência + Verba de Mídia) -->
            <div class="lead-step" data-step="3" hidden>
                <div class="lead-step-heading">
                    <span class="lead-step-num">3</span>
                    <div>
                        <span class="lead-step-kicker">Capacidade de Investimento</span>
                        <h3 class="lead-step-title">Expectativa de investimento mensal</h3>
                        <p class="lead-step-subtext">Para montarmos uma proposta sob medida para sua realidade:</p>
                    </div>
                </div>

                <!-- Pergunta 1: Budget Geral com a Agência -->
                <div class="lead-budget-block">
                    <label class="lead-budget-label" for="investimento_agencia">
                        💼 Quanto pretende investir com a gente por mês?
                    </label>
                    <div class="lead-budget-options">
                        <label class="lead-budget-pill">
                            <input type="radio" name="investimento_agencia" value="Ate R$ 2.500 / mes" required />
                            <span>Até R$ 2.500</span>
                        </label>
                        <label class="lead-budget-pill">
                            <input type="radio" name="investimento_agencia" value="De R$ 2.500 a R$ 5.000 / mes" />
                            <span>R$ 2.500 a R$ 5k</span>
                        </label>
                        <label class="lead-budget-pill">
                            <input type="radio" name="investimento_agencia" value="De R$ 5.000 a R$ 10.000 / mes" />
                            <span>R$ 5k a R$ 10k</span>
                        </label>
                        <label class="lead-budget-pill">
                            <input type="radio" name="investimento_agencia" value="Acima de R$ 10.000 / mes" />
                            <span>Acima de R$ 10k</span>
                        </label>
                    </div>
                </div>

                <!-- Pergunta 2: Verba para Tráfego / Anúncios -->
                <div class="lead-budget-block" style="margin-top: 1rem;">
                    <label class="lead-budget-label" for="investimento_anuncios">
                        📢 Desse total, quanto é pra tráfego pago?
                    </label>
                    <div class="lead-budget-options">
                        <label class="lead-budget-pill">
                            <input type="radio" name="investimento_anuncios" value="Ainda nao invisto em anuncios" required />
                            <span>Não invisto em anúncios</span>
                        </label>
                        <label class="lead-budget-pill">
                            <input type="radio" name="investimento_anuncios" value="Ate R$ 3.000 / mes em midia" />
                            <span>Até R$ 3.000 / mês</span>
                        </label>
                        <label class="lead-budget-pill">
                            <input type="radio" name="investimento_anuncios" value="De R$ 3.000 a R$ 10.000 / mes em midia" />
                            <span>R$ 3k a R$ 10k / mês</span>
                        </label>
                        <label class="lead-budget-pill">
                            <input type="radio" name="investimento_anuncios" value="Acima de R$ 10.000 / mes em midia" />
                            <span>Acima de R$ 10k / mês</span>
                        </label>
                    </div>
                </div>

                <p class="lead-step-error" id="error-step-3" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-back" data-previous-step="2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        Voltar
                    </button>
                    <button type="button" class="lead-btn-primary lead-btn-next" data-next-step="4">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- ETAPA 4: Dados de Contato (Etapa Final com Envio) -->
            <div class="lead-step" data-step="4" hidden>
                <div class="lead-step-heading">
                    <span class="lead-step-num">4</span>
                    <div>
                        <span class="lead-step-kicker">Finalizar Diagnóstico</span>
                        <h3 class="lead-step-title">Para onde enviamos a sua análise estratégica?</h3>
                    </div>
                </div>

                <div class="lead-inputs-grid">
                    <div class="lead-input-group">
                        <span class="lead-input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <input type="text" id="wizard-nome" name="nome" placeholder="Seu nome completo" autocomplete="name" required />
                    </div>

                    <div class="lead-input-group">
                        <span class="lead-input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                            </svg>
                        </span>
                        <input type="text" id="wizard-empresa" name="empresa" placeholder="Empresa ou @ no Instagram" required />
                    </div>

                    <div class="lead-input-group">
                        <span class="lead-input-icon lead-icon-wpp">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                            </svg>
                        </span>
                        <input type="tel" id="wizard-whatsapp" name="whatsapp" placeholder="WhatsApp: (16) 99999-9999" autocomplete="tel" inputmode="tel" required />
                    </div>

                    <div class="lead-input-group">
                        <span class="lead-input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </span>
                        <input type="email" id="wizard-email" name="email" placeholder="Seu e-mail profissional" autocomplete="email" required />
                    </div>
                </div>

                <p class="lead-step-error" id="error-step-4" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-back" data-previous-step="3">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        Voltar
                    </button>
                    <button type="submit" class="lead-btn-submit" id="leadWizardSubmitBtn">
                        <span>Concluir e Receber Diagnóstico</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- Rodapé de Privacidade -->
            <div class="lead-modal-privacy">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #59266d; flex-shrink: 0;">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Seus dados estão protegidos pela LGPD. Sem spam.</span>
            </div>
        </form>

        <!-- TELA DE SUCESSO (ESTÁTICA, NUNCA DESCONFIGURA O CSS) -->
        <div class="lead-success-screen" id="leadSuccessScreen" hidden>
            <div class="lead-success-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            
            <h3 class="lead-success-title" id="leadSuccessTitle">Diagnóstico Concluído!</h3>
            <p class="lead-success-desc" id="leadSuccessDesc">
                Mapeamos o momento da sua empresa. Enquanto nossa equipe estratégica prepara a sua análise personalizada, você já pode falar diretamente conosco:
            </p>

            <div class="lead-success-action-card">
                <div class="lead-success-action-kicker">🚀 Atendimento Prioritário</div>
                <p class="lead-success-action-text">Fale agora mesmo com nosso consultor no WhatsApp para acelerar o seu diagnóstico:</p>
                
                <a href="https://api.whatsapp.com/send?phone=551634154110" target="_blank" rel="noopener noreferrer" class="lead-success-wpp-btn" id="leadSuccessWppBtn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                    </svg>
                    Falar com consultor no WhatsApp →
                </a>
            </div>

            <button type="button" class="lead-success-close-btn js-lead-modal-close">Fechar janela</button>
        </div>
    </div>
</div>

<style is:global>
/* =========================================================
   ESTILOS GLOBAIS DO MODAL DE DIAGNÓSTICO (CLEAN & LUXURY)
   ========================================================= */
.lead-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
}

.lead-modal-overlay.active {
    opacity: 1;
    visibility: visible;
}

.lead-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
}

.lead-modal-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 540px;
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    background: #ffffff !important;
    border-radius: 20px;
    padding: 2rem 2.25rem;
    box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.25), 0 0 1px rgba(15, 23, 42, 0.1);
    transform: translateY(16px) scale(0.97);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    color: #1e293b !important;
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
}

.lead-modal-overlay.active .lead-modal-container {
    transform: translateY(0) scale(1);
}

/* Scrollbar */
.lead-modal-container::-webkit-scrollbar {
    width: 6px;
}
.lead-modal-container::-webkit-scrollbar-track {
    background: transparent;
}
.lead-modal-container::-webkit-scrollbar-thumb {
    background: #e2e8f0;
