</style>

<script is:inline>
(function () {
    const TOTAL_STEPS = 6;
    const FORM_ENDPOINT = 'https://api.web3forms.com/submit';
    const WEB3FORMS_KEY = 'c685ced6-cdf1-4deb-92d6-162a2f110e0e';
    const WHATSAPP_NUMBER = '551634154110';

    function initLeadWizard() {
        const modal = document.getElementById('leadWizardModal');
        const form = document.getElementById('leadWizardForm');
        if (!modal || !form) return;

        let currentStep = 1;

        // ==========================================
        // CONTROLE DE ABERTURA / FECHAMENTO
        // ==========================================
        function openModal() {
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            
            setTimeout(() => {
                const activeInput = modal.querySelector('.lead-step.active input:not([type="radio"]):not([type="checkbox"])');
                if (activeInput) activeInput.focus();
            }, 100);
        }

        function closeModal() {
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            
            if (window.location.hash === '#abrir-formulario' || window.location.hash === '#abrir-avaliacao' || window.location.hash === '#diagnostico') {
                history.replaceState(null, null, ' ');
            }
        }

        // Eventos de clique para abrir
        document.querySelectorAll('.js-open-modal, .js-open-diagnostico, a[href="#abrir-formulario"], a[href="#abrir-avaliacao"], a[href="#diagnostico"]').forEach(trigger => {
            trigger.addEventListener('click', (e) => {
                e.preventDefault();
                openModal();
            });
        });

        // Eventos de clique para fechar
        modal.querySelectorAll('.js-lead-modal-close').forEach(btn => {
            btn.addEventListener('click', closeModal);
        });

        // Fechar com ESC
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('active')) {
                closeModal();
            }
        });

        // Deep-linking automático na URL
        const validHashes = ['#abrir-formulario', '#abrir-avaliacao', '#diagnostico'];
        if (validHashes.includes(window.location.hash)) {
            setTimeout(openModal, 200);
        }
        window.addEventListener('hashchange', () => {
            if (validHashes.includes(window.location.hash)) {
                openModal();
            }
        });

        // ==========================================
        // MOTOR DE NAVEGAÇÃO ENTRE ETAPAS
        // ==========================================
        function updateProgress(step) {
            const pct = Math.round((step / TOTAL_STEPS) * 100);
            const progressBar = form.querySelector('.js-step-progress');
            const stepIndicator = form.querySelector('.js-step-indicator');
            const stepPct = form.querySelector('.js-step-pct');

            if (progressBar) progressBar.style.width = pct + '%';
            if (stepIndicator) stepIndicator.textContent = `Etapa ${step} de ${TOTAL_STEPS}`;
            if (stepPct) stepPct.textContent = pct + '%';
        }

        function goToStep(n) {
            currentStep = n;
            form.querySelectorAll('.lead-step').forEach(el => {
                const step = parseInt(el.dataset.step, 10);
                const isActive = step === n;
                el.classList.toggle('active', isActive);
                el.hidden = !isActive;
            });

            updateProgress(n);

            const activeStepEl = form.querySelector(`.lead-step[data-step="${n}"]`);
            if (activeStepEl) {
                const input = activeStepEl.querySelector('input:not([type="radio"]):not([type="checkbox"])');
                if (input) input.focus();
            }
        }

        function showError(stepNum, message) {
            const errEl = document.getElementById(`error-step-${stepNum}`);
            if (errEl) {
                errEl.textContent = message;
                errEl.classList.add('visible');
            }
        }

        function clearError(stepNum) {
            const errEl = document.getElementById(`error-step-${stepNum}`);
            if (errEl) {
                errEl.textContent = '';
                errEl.classList.remove('visible');
            }
        }

        function validateStep(step) {
            clearError(step);

            if (step === 1) {
                const nomeInput = form.querySelector('#wizard-nome');
                if (!nomeInput || !nomeInput.value.trim()) {
                    showError(1, 'Por favor, informe seu nome.');
                    nomeInput?.focus();
                    return false;
                }
                return true;
            }

            if (step === 2) {
                const empresaInput = form.querySelector('#wizard-empresa');
                if (!empresaInput || !empresaInput.value.trim()) {
                    showError(2, 'Por favor, informe o nome da sua empresa ou @ do Instagram.');
                    empresaInput?.focus();
                    return false;
                }
                return true;
            }

            if (step === 3) {
                const wppInput = form.querySelector('#wizard-whatsapp');
                const emailInput = form.querySelector('#wizard-email');

                if (!wppInput || wppInput.value.trim().replace(/\D/g, '').length < 10) {
                    showError(3, 'Por favor, informe um WhatsApp válido com DDD (mínimo 10 dígitos).');
                    wppInput?.focus();
                    return false;
                }

                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailInput || !emailRegex.test(emailInput.value.trim())) {
                    showError(3, 'Por favor, informe um endereço de e-mail válido.');
                    emailInput?.focus();
                    return false;
                }
                return true;
            }

            if (step === 4) {
                const selectedService = form.querySelector('input[name="servico_prioritario"]:checked');
                if (!selectedService) {
                    showError(4, 'Por favor, selecione qual é a prioridade da sua marca.');
                    return false;
                }
                return true;
            }

            if (step === 5) {
                const selectedBudget = form.querySelector('input[name="investimento_mensal"]:checked');
                if (!selectedBudget) {
                    showError(5, 'Por favor, selecione uma faixa de investimento.');
                    return false;
                }
                return true;
            }

            if (step === 6) {
                const checkedPains = form.querySelectorAll('input[name="desafios"]:checked');
                if (checkedPains.length === 0) {
                    showError(6, 'Por favor, selecione ao menos uma opção para concluir.');
                    return false;
                }
                return true;
            }

            return true;
        }

        // Botões Avançar
        form.querySelectorAll('.lead-btn-next').forEach(btn => {
            btn.addEventListener('click', () => {
                const nextStep = parseInt(btn.dataset.nextStep, 10);
                const current = nextStep - 1;
                if (validateStep(current)) {
                    goToStep(nextStep);
                }
            });
        });

        // Botões Voltar
        form.querySelectorAll('.lead-btn-back').forEach(btn => {
            btn.addEventListener('click', () => {
                const prevStep = parseInt(btn.dataset.previousStep, 10);
                goToStep(prevStep);
            });
        });

        // Enter no teclado avança etapa
        form.querySelectorAll('input:not([type="radio"]):not([type="checkbox"])').forEach(input => {
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const activeStepEl = input.closest('.lead-step');
                    if (!activeStepEl) return;
                    const stepNum = parseInt(activeStepEl.dataset.step, 10);
                    if (stepNum < TOTAL_STEPS && validateStep(stepNum)) {
                        goToStep(stepNum + 1);
                    }
                }
            });
        });

        // Interatividade visual nos Cards de Opções (Radio e Checkbox)
        form.querySelectorAll('.lead-quiz-card').forEach(card => {
            const input = card.querySelector('input');
            if (!input) return;

            card.addEventListener('click', () => {
                if (input.type === 'radio') {
                    card.closest('.lead-quiz-cards')?.querySelectorAll('.lead-quiz-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    input.checked = true;
                    clearError(currentStep);
                } else if (input.type === 'checkbox') {
                    setTimeout(() => {
                        card.classList.toggle('selected', input.checked);
                        clearError(currentStep);
                    }, 10);
                }
            });
        });

        // Máscara dinâmica de telefone / WhatsApp
        const wppInput = form.querySelector('#wizard-whatsapp');
        if (wppInput) {
            wppInput.addEventListener('input', (e) => {
                let v = e.target.value.replace(/\D/g, '');
                if (v.length > 11) v = v.slice(0, 11);
                if (v.length > 10) {
                    v = v.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
                } else if (v.length > 5) {
                    v = v.replace(/^(\d{2})(\d{4})(\d{0,4})$/, '($1) $2-$3');
                } else if (v.length > 2) {
                    v = v.replace(/^(\d{2})(\d{0,5})$/, '($1) $2');
                } else if (v.length > 0) {
                    v = v.replace(/^(\d*)$/, '($1');
                }
                e.target.value = v;
            });
        }

        // ==========================================
        // SUBMISSÃO DO FORMULÁRIO (ENTREGA + CONVERSÃO)
        // ==========================================
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            if (!validateStep(TOTAL_STEPS)) return;

            const submitBtn = document.getElementById('leadWizardSubmitBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span>Enviando diagnóstico...</span>';
            }

            // Captura de UTMs da URL
            const urlParams = new URLSearchParams(window.location.search);
            const utms = {
                utm_source: urlParams.get('utm_source') || 'direto',
                utm_medium: urlParams.get('utm_medium') || 'nenhum',
                utm_campaign: urlParams.get('utm_campaign') || 'nenhuma',
                utm_content: urlParams.get('utm_content') || '',
                utm_term: urlParams.get('utm_term') || '',
                pagina_conversao: window.location.href,
                data_envio: new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' })
            };

            // Coleta de dados
            const nome = (form.querySelector('#wizard-nome')?.value || '').trim();
            const empresa = (form.querySelector('#wizard-empresa')?.value || '').trim();
            const whatsapp = (form.querySelector('#wizard-whatsapp')?.value || '').trim();
            const email = (form.querySelector('#wizard-email')?.value || '').trim();
            const servico = form.querySelector('input[name="servico_prioritario"]:checked')?.value || 'Não informado';
            const investimento = form.querySelector('input[name="investimento_mensal"]:checked')?.value || 'Não informado';
            
            const desafiosArr = [];
            form.querySelectorAll('input[name="desafios"]:checked').forEach(c => desafiosArr.push(c.value));
            const desafios = desafiosArr.join(', ') || 'Nenhum informado';

            const payload = {
                access_key: WEB3FORMS_KEY,
                subject: `🎯 Novo Diagnóstico de Marketing: ${nome} (${empresa})`,
                from_name: 'Diagnóstico Filomena Propaganda',
                nome: nome,
                empresa_ou_instagram: empresa,
                whatsapp: whatsapp,
                email: email,
                servico_prioritario: servico,
                investimento_mensal_anuncios: investimento,
                principais_desafios: desafios,
                ...utms
            };

            // Dispara Eventos de Conversão (GTM, GA4, Meta Pixel)
            try {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                    event: 'generate_lead',
                    form_name: 'diagnostico_filomena',
                    lead_name: nome,
                    lead_company: empresa,
                    lead_service: servico,
                    lead_budget: investimento
                });

                if (typeof window.gtag === 'function') {
                    window.gtag('event', 'generate_lead', {
                        event_category: 'form',
                        event_label: 'diagnostico_filomena',
                        value: 1
                    });
                }

                if (typeof window.fbq === 'function') {
                    window.fbq('track', 'Lead', {
                        content_name: 'diagnostico_filomena',
                        value: 1,
                        currency: 'BRL'
                    });
                }
            } catch (trackErr) {
                console.warn('Rastreamento de conversão:', trackErr);
            }

            // Envio via Web3Forms
            try {
                await fetch(FORM_ENDPOINT, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload),
                    keepalive: true
                });
            } catch (sendErr) {
                console.warn('Aviso: envio do formulário falhou:', sendErr);
            }

            // ==========================================
            // TELA DE SUCESSO ELEGANTE E ESTRUTURADA
            // ==========================================
            const cleanFirstName = nome.split(' ')[0] || 'Obrigado';
            const wppMessage = encodeURIComponent(
