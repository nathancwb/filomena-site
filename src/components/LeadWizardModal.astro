</style>

<script is:inline>
(function () {
    const TOTAL_STEPS = 4;
    const FORM_ENDPOINT = 'https://api.web3forms.com/submit';
    const WEB3FORMS_KEY = 'c685ced6-cdf1-4deb-92d6-162a2f110e0e';
    const WHATSAPP_NUMBER = '551634154110';

    function initLeadWizard() {
        const modal = document.getElementById('leadWizardModal');
        const form = document.getElementById('leadWizardForm');
        const successScreen = document.getElementById('leadSuccessScreen');
        if (!modal || !form) return;

        let currentStep = 1;

        function openModal() {
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            
            // Reseta para tela de formulário se já tinha enviado
            if (form.hidden && successScreen) {
                form.hidden = false;
                successScreen.hidden = true;
                goToStep(1);
            }
        }

        function closeModal() {
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            
            if (window.location.hash === '#abrir-formulario' || window.location.hash === '#abrir-avaliacao' || window.location.hash === '#diagnostico') {
                history.replaceState(null, null, ' ');
            }
        }

        document.querySelectorAll('.js-open-modal, .js-open-diagnostico, a[href="#abrir-formulario"], a[href="#abrir-avaliacao"], a[href="#diagnostico"]').forEach(trigger => {
            trigger.addEventListener('click', (e) => {
                e.preventDefault();
                openModal();
            });
        });

        modal.querySelectorAll('.js-lead-modal-close').forEach(btn => {
            btn.addEventListener('click', closeModal);
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('active')) {
                closeModal();
            }
        });

        const validHashes = ['#abrir-formulario', '#abrir-avaliacao', '#diagnostico'];
        if (validHashes.includes(window.location.hash)) {
            setTimeout(openModal, 200);
        }
        window.addEventListener('hashchange', () => {
            if (validHashes.includes(window.location.hash)) {
                openModal();
            }
        });

        function updateProgress(step) {
            const pct = Math.round((step / TOTAL_STEPS) * 100);
            const progressBar = form.querySelector('.js-step-progress');
            const stepIndicator = form.querySelector('.js-step-indicator');
            const stepPct = form.querySelector('.js-step-pct');

            if (progressBar) progressBar.style.width = pct + '%';
            if (stepIndicator) stepIndicator.textContent = `Etapa ${step} de ${TOTAL_STEPS}`;
            if (stepPct) stepPct.textContent = pct + '%';
        }

        function goToStep(n) {
            currentStep = n;
            form.querySelectorAll('.lead-step').forEach(el => {
                const step = parseInt(el.dataset.step, 10);
                const isActive = step === n;
                el.classList.toggle('active', isActive);
                el.hidden = !isActive;
            });

            updateProgress(n);

            const activeStepEl = form.querySelector(`.lead-step[data-step="${n}"]`);
            if (activeStepEl) {
                const input = activeStepEl.querySelector('input:not([type="radio"]):not([type="checkbox"])');
                if (input) input.focus();
            }
        }

        function showError(stepNum, message) {
            const errEl = document.getElementById(`error-step-${stepNum}`);
            if (errEl) {
                errEl.textContent = message;
                errEl.classList.add('visible');
            }
        }

        function clearError(stepNum) {
            const errEl = document.getElementById(`error-step-${stepNum}`);
            if (errEl) {
                errEl.textContent = '';
                errEl.classList.remove('visible');
            }
        }

        function validateStep(step) {
            clearError(step);

            if (step === 1) {
                const selectedService = form.querySelector('input[name="servico_prioritario"]:checked');
                if (!selectedService) {
                    showError(1, 'Por favor, selecione qual é a prioridade da sua marca.');
                    return false;
                }
                return true;
            }

            if (step === 2) {
                const checkedPains = form.querySelectorAll('input[name="desafios"]:checked');
                if (checkedPains.length === 0) {
                    showError(2, 'Por favor, selecione ao menos um gargalo para avançar.');
                    return false;
                }
                return true;
            }

            if (step === 3) {
                const budgetAgencia = form.querySelector('input[name="investimento_agencia"]:checked');
                const budgetAds = form.querySelector('input[name="investimento_anuncios"]:checked');

                if (!budgetAgencia) {
                    showError(3, 'Por favor, selecione a faixa de investimento pretendida com a agência.');
                    return false;
                }
                if (!budgetAds) {
                    showError(3, 'Por favor, selecione a verba prevista para anúncios/mídia paga.');
                    return false;
                }
                return true;
            }

            if (step === 4) {
                const nomeInput = form.querySelector('#wizard-nome');
                const empresaInput = form.querySelector('#wizard-empresa');
                const wppInput = form.querySelector('#wizard-whatsapp');
                const emailInput = form.querySelector('#wizard-email');

                if (!nomeInput || !nomeInput.value.trim()) {
                    showError(4, 'Por favor, informe seu nome.');
                    nomeInput?.focus();
                    return false;
                }

                if (!empresaInput || !empresaInput.value.trim()) {
                    showError(4, 'Por favor, informe o nome da sua empresa ou @ no Instagram.');
                    empresaInput?.focus();
                    return false;
                }

                if (!wppInput || wppInput.value.trim().replace(/\D/g, '').length < 10) {
                    showError(4, 'Por favor, informe um WhatsApp válido com DDD.');
                    wppInput?.focus();
                    return false;
                }

                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailInput || !emailRegex.test(emailInput.value.trim())) {
                    showError(4, 'Por favor, informe um endereço de e-mail válido.');
                    emailInput?.focus();
                    return false;
                }
                return true;
            }

            return true;
        }

        form.querySelectorAll('.lead-btn-next').forEach(btn => {
            btn.addEventListener('click', () => {
                const nextStep = parseInt(btn.dataset.nextStep, 10);
                const current = nextStep - 1;
                if (validateStep(current)) {
                    goToStep(nextStep);
                }
            });
        });

        form.querySelectorAll('.lead-btn-back').forEach(btn => {
            btn.addEventListener('click', () => {
                const prevStep = parseInt(btn.dataset.previousStep, 10);
                goToStep(prevStep);
            });
        });

        // Interatividade visual nos cards
        form.querySelectorAll('.lead-quiz-card').forEach(card => {
            const input = card.querySelector('input');
            if (!input) return;

            card.addEventListener('click', () => {
                if (input.type === 'radio') {
                    card.closest('.lead-quiz-cards')?.querySelectorAll('.lead-quiz-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    input.checked = true;
                    clearError(currentStep);
                } else if (input.type === 'checkbox') {
                    setTimeout(() => {
                        card.classList.toggle('selected', input.checked);
                        clearError(currentStep);
                    }, 10);
                }
            });
        });

        // Interatividade nas pílulas de budget
        form.querySelectorAll('.lead-budget-pill').forEach(pill => {
            const input = pill.querySelector('input');
            if (!input) return;

            pill.addEventListener('click', () => {
                pill.closest('.lead-budget-options')?.querySelectorAll('.lead-budget-pill').forEach(p => p.classList.remove('selected'));
                pill.classList.add('selected');
                input.checked = true;
                clearError(currentStep);
            });
        });

        // Máscara WhatsApp
        const wppInput = form.querySelector('#wizard-whatsapp');
        if (wppInput) {
            wppInput.addEventListener('input', (e) => {
                let v = e.target.value.replace(/\D/g, '');
                if (v.length > 11) v = v.slice(0, 11);
                if (v.length > 10) {
                    v = v.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
                } else if (v.length > 5) {
                    v = v.replace(/^(\d{2})(\d{4})(\d{0,4})$/, '($1) $2-$3');
                } else if (v.length > 2) {
                    v = v.replace(/^(\d{2})(\d{0,5})$/, '($1) $2');
                } else if (v.length > 0) {
                    v = v.replace(/^(\d*)$/, '($1');
                }
                e.target.value = v;
            });
        }

        // SUBMIT
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            if (!validateStep(TOTAL_STEPS)) return;

            const submitBtn = document.getElementById('leadWizardSubmitBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span>Processando envio...</span>';
            }

            const urlParams = new URLSearchParams(window.location.search);
            const utms = {
                utm_source: urlParams.get('utm_source') || 'direto',
                utm_medium: urlParams.get('utm_medium') || 'nenhum',
                utm_campaign: urlParams.get('utm_campaign') || 'nenhuma',
                utm_content: urlParams.get('utm_content') || '',
                utm_term: urlParams.get('utm_term') || '',
                pagina_conversao: window.location.href,
                data_envio: new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' })
            };

            const nome = (form.querySelector('#wizard-nome')?.value || '').trim();
            const empresa = (form.querySelector('#wizard-empresa')?.value || '').trim();
            const whatsapp = (form.querySelector('#wizard-whatsapp')?.value || '').trim();
            const email = (form.querySelector('#wizard-email')?.value || '').trim();
            const servico = form.querySelector('input[name="servico_prioritario"]:checked')?.value || 'Não informado';
            const budgetAgencia = form.querySelector('input[name="investimento_agencia"]:checked')?.value || 'Não informado';
            const budgetAds = form.querySelector('input[name="investimento_anuncios"]:checked')?.value || 'Não informado';
            
            const desafiosArr = [];
            form.querySelectorAll('input[name="desafios"]:checked').forEach(c => desafiosArr.push(c.value));
            const desafios = desafiosArr.join(', ') || 'Nenhum informado';

            const payload = {
                access_key: WEB3FORMS_KEY,
                subject: `🎯 Novo Diagnóstico: ${nome} (${empresa})`,
                from_name: 'Diagnóstico Filomena Propaganda',
                nome: nome,
                empresa_ou_instagram: empresa,
                whatsapp: whatsapp,
                email: email,
                servico_prioritario: servico,
                investimento_com_agencia: budgetAgencia,
                verba_para_anuncios: budgetAds,
                principais_gargalos: desafios,
                ...utms
            };

            // Eventos de Conversão
            try {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                    event: 'generate_lead',
                    form_name: 'diagnostico_filomena',
                    lead_name: nome,
                    lead_company: empresa,
                    lead_service: servico,
                    lead_budget_agency: budgetAgencia,
                    lead_budget_ads: budgetAds
                });

                if (typeof window.gtag === 'function') {
                    window.gtag('event', 'generate_lead', {
                        event_category: 'form',
                        event_label: 'diagnostico_filomena',
                        value: 1
                    });
                }

                if (typeof window.fbq === 'function') {
                    window.fbq('track', 'Lead', {
                        content_name: 'diagnostico_filomena',
                        value: 1,
                        currency: 'BRL'
                    });
                }
            } catch (trackErr) {
                console.warn('Rastreamento de conversão:', trackErr);
            }

            // Envio Web3Forms
            try {
                await fetch(FORM_ENDPOINT, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload),
                    keepalive: true
                });
            } catch (sendErr) {
                console.warn('Envio do formulário:', sendErr);
            }

            // EXIBE TELA DE SUCESSO ESTÁTICA COM CSS TOTALMENTE PRESERVADO
            const cleanFirstName = nome.split(' ')[0] || 'Obrigado';
            const wppMessage = encodeURIComponent(
                `Olá equipe Filomena! Meu nome é *${nome}* (da *${empresa}*). Acabei de preencher o diagnóstico no site e gostaria de agilizar minha análise com os especialistas.`
            );
            const wppDirectLink = `https://api.whatsapp.com/send?phone=${WHATSAPP_NUMBER}&text=${wppMessage}`;

            form.hidden = true;
            if (successScreen) {
                const titleEl = document.getElementById('leadSuccessTitle');
                const descEl = document.getElementById('leadSuccessDesc');
                const wppBtnEl = document.getElementById('leadSuccessWppBtn');

                if (titleEl) titleEl.textContent = `Diagnóstico Concluído, ${cleanFirstName}!`;
                if (descEl) descEl.innerHTML = `Mapeamos o momento da <strong>${empresa}</strong>. Enquanto nossa equipe estratégica prepara a sua análise personalizada, você já pode falar diretamente conosco:`;
                if (wppBtnEl) wppBtnEl.href = wppDirectLink;

                successScreen.hidden = false;
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLeadWizard);
    } else {
        initLeadWizard();
    }
    document.addEventListener('astro:page-load', initLeadWizard);
})();
</script>
