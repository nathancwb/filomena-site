---
// Componente Modal de Captação de Lead em Múltiplas Etapas (Wizard / Diagnóstico Estratégico)
---

<!-- Modal Overlay -->
<div class="lead-modal-overlay js-lead-modal" id="leadWizardModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="leadModalTitle">
    <div class="lead-modal-backdrop js-lead-modal-close" tabindex="-1"></div>
    
    <div class="lead-modal-container">
        <!-- Botão Fechar -->
        <button type="button" class="lead-modal-close js-lead-modal-close" aria-label="Fechar diagnóstico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <!-- Header / Badge -->
        <div class="lead-modal-header">
            <span class="lead-modal-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
                Diagnóstico Estratégico Gratuito
            </span>
        </div>

        <!-- Form Wizard -->
        <form class="lead-modal-form js-lead-form" id="leadWizardForm" novalidate>
            <!-- Barra de Progresso -->
            <div class="lead-progress-wrapper" aria-label="Progresso do formulário">
                <div class="lead-progress-track">
                    <span class="lead-progress-bar js-step-progress" style="width: 16.66%;"></span>
                </div>
                <div class="lead-progress-meta">
                    <span class="lead-progress-step-text js-step-indicator">Etapa 1 de 6</span>
                    <span class="lead-progress-pct js-step-pct">16%</span>
                </div>
            </div>

            <!-- STEP 1: Nome -->
            <div class="lead-step active" data-step="1">
                <div class="lead-step-heading">
                    <span class="lead-step-num">1</span>
                    <div>
                        <span class="lead-step-kicker">Primeiro contato</span>
                        <h3 class="lead-step-title" id="leadModalTitle">Como podemos te chamar?</h3>
                    </div>
                </div>
                <div class="lead-input-group">
                    <span class="lead-input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </span>
                    <input type="text" id="wizard-nome" name="nome" placeholder="Digite seu nome completo" autocomplete="name" required />
                </div>
                <p class="lead-step-error" id="error-step-1" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-primary lead-btn-next" data-next-step="2">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- STEP 2: Empresa / Instagram -->
            <div class="lead-step" data-step="2" hidden>
                <div class="lead-step-heading">
                    <span class="lead-step-num">2</span>
                    <div>
                        <span class="lead-step-kicker">Sobre a sua marca</span>
                        <h3 class="lead-step-title">Qual é a sua empresa ou @ no Instagram?</h3>
                    </div>
                </div>
                <div class="lead-input-group">
                    <span class="lead-input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                    </span>
                    <input type="text" id="wizard-empresa" name="empresa" placeholder="Ex: Minha Marca ou @minhamarca" required />
                </div>
                <p class="lead-step-error" id="error-step-2" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-back" data-previous-step="1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        Voltar
                    </button>
                    <button type="button" class="lead-btn-primary lead-btn-next" data-next-step="3">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- STEP 3: Contatos Diretos (WhatsApp & E-mail) -->
            <div class="lead-step" data-step="3" hidden>
                <div class="lead-step-heading">
                    <span class="lead-step-num">3</span>
                    <div>
                        <span class="lead-step-kicker">Para enviarmos a análise</span>
                        <h3 class="lead-step-title">Onde podemos te enviar o retorno?</h3>
                    </div>
                </div>
                <div class="lead-inputs-dual">
                    <div class="lead-input-group">
                        <span class="lead-input-icon lead-icon-wpp">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                            </svg>
                        </span>
                        <input type="tel" id="wizard-whatsapp" name="whatsapp" placeholder="WhatsApp: (16) 99999-9999" autocomplete="tel" inputmode="tel" required />
                    </div>
                    <div class="lead-input-group">
                        <span class="lead-input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </span>
                        <input type="email" id="wizard-email" name="email" placeholder="Seu melhor e-mail profissional" autocomplete="email" required />
                    </div>
                </div>
                <p class="lead-step-error" id="error-step-3" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-back" data-previous-step="2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        Voltar
                    </button>
                    <button type="button" class="lead-btn-primary lead-btn-next" data-next-step="4">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- STEP 4: Objetivo Principal (Single-Select Radio) -->
            <div class="lead-step" data-step="4" hidden>
                <div class="lead-step-heading">
                    <span class="lead-step-num">4</span>
                    <div>
                        <span class="lead-step-kicker">Objetivo Estratégico</span>
                        <h3 class="lead-step-title">Qual é a prioridade da sua marca hoje?</h3>
                    </div>
                </div>
                <div class="lead-quiz-cards">
                    <label class="lead-quiz-card">
                        <input type="radio" name="servico_prioritario" value="Branding e Identidade Visual" required />
                        <span class="lead-card-key">A</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Branding & Identidade Visual</strong>
                            <span class="lead-card-desc">Construir ou reformular logotipo, manual de marca e posicionamento</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="servico_prioritario" value="Tráfego Pago e Performance" />
                        <span class="lead-card-key">B</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Tráfego Pago & Vendas (Google/Meta Ads)</strong>
                            <span class="lead-card-desc">Anúncios de alta performance para gerar leads e acelerar o faturamento</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="servico_prioritario" value="Gestao Completa 360" />
                        <span class="lead-card-key">C</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Assessoria Completa 360°</strong>
                            <span class="lead-card-desc">Planejamento estratégico, redes sociais, criativos e equipe de marketing</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="servico_prioritario" value="Criacao de Site ou Landing Page" />
                        <span class="lead-card-key">D</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Criação de Site / Landing Page</strong>
                            <span class="lead-card-desc">Desenvolvimento de site moderno, veloz e otimizado para conversão</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>
                </div>
                <p class="lead-step-error" id="error-step-4" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-back" data-previous-step="3">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        Voltar
                    </button>
                    <button type="button" class="lead-btn-primary lead-btn-next" data-next-step="5">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- STEP 5: Investimento em Anúncios (Single-Select Radio) -->
            <div class="lead-step" data-step="5" hidden>
                <div class="lead-step-heading">
                    <span class="lead-step-num">5</span>
                    <div>
                        <span class="lead-step-kicker">Maturidade & Investimento</span>
                        <h3 class="lead-step-title">Quanto a sua empresa investe em anúncios por mês?</h3>
                    </div>
                </div>
                <div class="lead-quiz-cards">
                    <label class="lead-quiz-card">
                        <input type="radio" name="investimento_mensal" value="Ainda nao invisto em anuncios" required />
                        <span class="lead-card-key">A</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Ainda não invisto em anúncios</strong>
                            <span class="lead-card-desc">Quero iniciar do jeito certo com planejamento e metodologia</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="investimento_mensal" value="Ate R$ 3.000 / mes" />
                        <span class="lead-card-key">B</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Até R$ 3.000 / mês</strong>
                            <span class="lead-card-desc">Já faço ações pontuais e busco profissionalizar minha estratégia</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="investimento_mensal" value="De R$ 3.000 a R$ 10.000 / mes" />
                        <span class="lead-card-key">C</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">De R$ 3.000 a R$ 10.000 / mês</strong>
                            <span class="lead-card-desc">Operação ativa buscando escala de vendas e redução de CAC</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card">
                        <input type="radio" name="investimento_mensal" value="Acima de R$ 10.000 / mes" />
                        <span class="lead-card-key">D</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Acima de R$ 10.000 / mês</strong>
                            <span class="lead-card-desc">Empresa consolidada buscando domínio de mercado e liderança</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>
                </div>
                <p class="lead-step-error" id="error-step-5" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-back" data-previous-step="4">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        Voltar
                    </button>
                    <button type="button" class="lead-btn-primary lead-btn-next" data-next-step="6">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- STEP 6: Principais Dificuldades (Multi-Select Checkbox - SUBMIT FINAL) -->
            <div class="lead-step" data-step="6" hidden>
                <div class="lead-step-heading">
                    <span class="lead-step-num">6</span>
                    <div>
                        <span class="lead-step-kicker">Diagnóstico Final</span>
                        <h3 class="lead-step-title">Quais desses desafios você mais enfrenta hoje?</h3>
                        <p class="lead-step-subtext">Selecione uma ou mais opções aplicáveis:</p>
                    </div>
                </div>
                <div class="lead-quiz-cards">
                    <label class="lead-quiz-card lead-card-checkbox">
                        <input type="checkbox" name="desafios" value="Poucos leads ou vendas estagnadas" />
                        <span class="lead-card-key">A</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Poucos leads qualificados ou vendas travadas</strong>
                            <span class="lead-card-desc">Dificuldade em manter um fluxo previsível de novos clientes</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card lead-card-checkbox">
                        <input type="checkbox" name="desafios" value="Marca sem destaque da concorrencia" />
                        <span class="lead-card-key">B</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Marca desvalorizada / guerra de preços</strong>
                            <span class="lead-card-desc">Clientes comparam seu negócio apenas por preço e não pelo valor</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card lead-card-checkbox">
                        <input type="checkbox" name="desafios" value="Anuncios com pouco retorno ou CAC alto" />
                        <span class="lead-card-key">C</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Anúncios sem retorno / Custo alto</strong>
                            <span class="lead-card-desc">Investimento em tráfego pago sem clareza de conversão ou ROAS</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>

                    <label class="lead-quiz-card lead-card-checkbox">
                        <input type="checkbox" name="desafios" value="Falta de equipe ou consistencia de marketing" />
                        <span class="lead-card-key">D</span>
                        <div class="lead-card-body">
                            <strong class="lead-card-title">Falta de tempo e consistência na equipe</strong>
                            <span class="lead-card-desc">Redes sociais desatualizadas e sem estratégia de longo prazo</span>
                        </div>
                        <span class="lead-card-check">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </label>
                </div>
                <p class="lead-step-error" id="error-step-6" role="alert"></p>
                <div class="lead-step-actions">
                    <button type="button" class="lead-btn-back" data-previous-step="5">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        Voltar
                    </button>
                    <button type="submit" class="lead-btn-submit" id="leadWizardSubmitBtn">
                        <span>Concluir e Enviar Diagnóstico</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- Rodapé de Privacidade -->
            <div class="lead-modal-privacy">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #59266d; flex-shrink: 0;">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Seus dados estão protegidos pela LGPD. Sem spam.</span>
            </div>
        </form>
    </div>
</div>

<style>
/* =========================================================
   MODAL DE DIAGNÓSTICO (ESTILO CLEAN / CLARO ELEGANTE)
   ========================================================= */
.lead-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
}

.lead-modal-overlay.active {
    opacity: 1;
    visibility: visible;
}

.lead-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
}

.lead-modal-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 540px;
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem 2.25rem;
    box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.3), 0 0 1px rgba(15, 23, 42, 0.1);
    transform: translateY(16px) scale(0.97);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    color: #1e293b;
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
}

.lead-modal-overlay.active .lead-modal-container {
    transform: translateY(0) scale(1);
}

/* Scrollbar */
.lead-modal-container::-webkit-scrollbar {
    width: 6px;
}
.lead-modal-container::-webkit-scrollbar-track {
    background: transparent;
}
.lead-modal-container::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 999px;
}

/* Botão Fechar */
.lead-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #64748b;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
}

.lead-modal-close:hover {
    background: #59266d;
    color: #ffffff;
    border-color: #59266d;
    transform: rotate(90deg);
}

/* Header & Badge */
.lead-modal-header {
    margin-bottom: 1rem;
}

.lead-modal-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
