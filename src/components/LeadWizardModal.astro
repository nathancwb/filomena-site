            `;

            form.querySelectorAll('.js-lead-modal-close').forEach(b => b.addEventListener('click', closeModal));
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLeadWizard);
    } else {
        initLeadWizard();
    }
    document.addEventListener('astro:page-load', initLeadWizard);
})();
</script>
