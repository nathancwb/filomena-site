---
---
<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="footer__grid">
            <div class="footer__brand">
                <a href="/" class="logo logo--footer">
                    <img src="/assets/images/footer-logo.png" alt="Filomena Propaganda & Marketing" class="logo__img">
                </a>
                <p>Comunicação criativa que conecta.</p>
                <span class="footer__tagline">#teamfilomena</span>
            
                <div class="footer__socials" style="display: flex; gap: var(--space-md); margin-top: var(--space-md);">
                    <a href="https://www.instagram.com/filomenapropaganda/" target="_blank" class="social-btn" aria-label="Instagram" style="color: var(--gray-300); transition: color var(--transition); display: inline-flex; align-items: center; justify-content: center;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    </a>
                    <a href="https://www.facebook.com/filomenapropaganda" target="_blank" class="social-btn" aria-label="Facebook" style="color: var(--gray-300); transition: color var(--transition); display: inline-flex; align-items: center; justify-content: center;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                    </a>
                    <a href="https://www.linkedin.com/company/filomena-propaganda/" target="_blank" class="social-btn" aria-label="LinkedIn" style="color: var(--gray-300); transition: color var(--transition); display: inline-flex; align-items: center; justify-content: center;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                    </a>
                    <a href="https://www.behance.net/filomenapropaganda" target="_blank" class="social-btn" aria-label="Behance" style="color: var(--gray-300); transition: color var(--transition); display: inline-flex; align-items: center; justify-content: center;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 1.949 1.63 2.667 3.25 2.667 1.56 0 2.509-.758 2.905-1.638H24zm-7.02-4h4.045c-.093-1.383-.752-2.132-1.934-2.132-1.221 0-1.934.748-2.111 2.132zM8.691 14.475c0 1.155-.614 1.85-1.912 1.85H3.43v-3.727h3.35c1.284 0 1.911.687 1.911 1.877zM3.43 8.686v3.165H6.5c1.086 0 1.73-.488 1.73-1.548 0-1.064-.644-1.617-1.73-1.617H3.43zM0 6h7.158c1.76 0 3.586 0 4.645 1.288.635.739.984 1.713.984 2.888 0 1.463-.698 2.573-1.985 3.067v.032c1.644.38 2.515 1.577 2.515 3.406 0 2.67-1.969 4.319-5.027 4.319H0V6z"/></svg>
                    </a>
                </div>
            </div>

            <div>
                <h4 class="footer__title">Navegação</h4>
                <ul class="footer__links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/sobre">Sobre nós</a></li>
                    <li><a href="/servicos">Serviços</a></li>
                    <li><a href="/portfolio">Portfólio</a></li>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/trabalhe-conosco">Trabalhe Conosco</a></li>
                    <li><a href="/contato">Contato</a></li>
                </ul>
            </div>

            <div>
                <h4 class="footer__title">Serviços</h4>
                <ul class="footer__links">
                    <li><a href="/servicos#branding">Branding</a></li>
                    <li><a href="/servicos#marketing">Marketing Digital</a></li>
                    <li><a href="/servicos#audiovisual">Audiovisual</a></li>
                    <li><a href="/servicos#midia">Mídia</a></li>
                </ul>
            </div>

            <div>
                <h4 class="footer__title">Contato</h4>
                <ul class="footer__links">
                    <li style="display: flex; align-items: center; gap: 8px; font-size: var(--text-sm); margin-bottom: var(--space-sm);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--secondary);"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.08.64.21 1.27.38 1.88a2 2 0 0 1-.45 2.11L8.09 8.66a16 16 0 0 0 6 6l.95-.95a2 2 0 0 1 2.11-.45c.61.17 1.24.3 1.88.38a2 2 0 0 1 1.72 2v2.28z"/></svg>
                        <a href="tel:+551634154110">(16) 3415-4110</a>
                    </li>
                    <li style="display: flex; align-items: center; gap: 8px; font-size: var(--text-sm); margin-bottom: var(--space-sm);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--secondary);"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <a href="mailto:contato@filomenapropaganda.com.br" style="word-break: break-all;">contato@filomenapropaganda.com.br</a>
                    </li>
                    <li style="display: flex; align-items: flex-start; gap: 8px; font-size: var(--text-sm); line-height: 1.5;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top: 3px; flex-shrink: 0; color: var(--secondary);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <a href="https://www.google.com/maps/place/Filomena+Propaganda+e+Marketing/@-22.0089776,-47.8877838,17z" target="_blank">Rua Dom Pedro II, 1978<br>São Carlos - SP</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer__bottom">
            <p>&copy; 2025 Filomena Propaganda. Todos os direitos reservados.</p>
            <p>São Carlos - SP</p>
        </div>
    </div>
</footer>

<style>
    .social-btn:hover {
        color: var(--secondary) !important;
        transform: translateY(-3px);
    }
    .social-btn {
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
    }
    .footer__links a:hover {
        color: var(--secondary) !important;
    }
</style>
