---
---
<div class="phoenix-container" id="phoenix-wrapper">
    <div class="phoenix-inner" id="phoenix-inner">
        <img src="/assets/images/phoenix.png" alt="Fênix Filomena" class="phoenix-image">
    </div>
</div>

<style>
    .phoenix-container {
        width: 100%;
        height: 100%;
        min-height: 500px;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        border-radius: 24px;
        background: radial-gradient(circle at center, #1a0822 0%, #0a0a0a 100%);
        perspective: 1000px; /* Para o efeito 3D */
    }

    .phoenix-inner {
        width: 120%;
        height: 120%;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: transform 0.1s ease-out;
        transform-style: preserve-3d;
        animation: float 6s ease-in-out infinite;
    }

    .phoenix-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: translateZ(50px); /* Traz a imagem para frente no espaço 3D */
        filter: drop-shadow(0 0 30px rgba(144, 71, 186, 0.4));
        mix-blend-mode: screen;
    }

    @keyframes float {
        0% {
            transform: translateY(0px) rotateX(0) rotateY(0);
        }
        50% {
            transform: translateY(-15px) rotateX(2deg) rotateY(-2deg);
        }
        100% {
            transform: translateY(0px) rotateX(0) rotateY(0);
        }
    }
</style>

<script>
    function init3DParallax() {
        const wrapper = document.getElementById('phoenix-wrapper');
        const inner = document.getElementById('phoenix-inner');
        
        if (!wrapper || !inner) return;

        wrapper.addEventListener('mousemove', (e) => {
            const rect = wrapper.getBoundingClientRect();
            
            // Calcula a posição do mouse relativa ao centro da div (-1 a 1)
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;

            // Multiplicador para controlar a intensidade do giro
            const rotateX = -y * 20; // graus
            const rotateY = x * 20; // graus

            inner.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        wrapper.addEventListener('mouseleave', () => {
            // Volta suavemente ao centro quando o mouse sai
            inner.style.transition = 'transform 0.5s ease-out';
            inner.style.transform = `rotateX(0deg) rotateY(0deg)`;
            
            // Remove a transição depois para o mousemove voltar a ser instantâneo
            setTimeout(() => {
                inner.style.transition = 'transform 0.1s ease-out';
            }, 500);
        });
    }

    document.addEventListener('DOMContentLoaded', init3DParallax);
    document.addEventListener('astro:page-load', init3DParallax);
</script>
