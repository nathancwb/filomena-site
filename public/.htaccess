# ==========================================================================
# Filomena Propaganda — configuracao Apache (HostGator / cPanel)
# Este arquivo e copiado para a raiz do site (public_html) no build.
# Substitui os headers que antes vinham do vercel.json e adiciona
# compressao + cache que a Vercel fornecia automaticamente.
# ==========================================================================

# --------------------------------------------------------------------------
# 1) Redirecionamentos canonicos: forca HTTPS + dominio com "www"
#    (o site usa https://www.filomenapropaganda.com.br como URL oficial)
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https  OU  sem-www -> www  (em um unico salto)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.filomenapropaganda.com.br%{REQUEST_URI} [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# 2) Pagina de erro 404 personalizada
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# 3) Compressao (gzip) — reduz HTML/CSS/JS em ~70-80%
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf application/font-woff2
</IfModule>

# --------------------------------------------------------------------------
# 4) Cache do navegador (Expires) — acelera visitas recorrentes
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: sempre revalida para refletir atualizacoes de conteudo na hora
  ExpiresByType text/html                 "access plus 0 seconds"

  # CSS / JS (servidos sem hash) — cache curto para nao travar atualizacoes
  ExpiresByType text/css                  "access plus 1 day"
  ExpiresByType application/javascript    "access plus 1 day"
  ExpiresByType text/javascript           "access plus 1 day"

  # Imagens — mudam pouco
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/x-icon              "access plus 30 days"

  # Fontes e videos — praticamente imutaveis
  ExpiresByType font/ttf                  "access plus 1 year"
  ExpiresByType font/otf                  "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
</IfModule>

# --------------------------------------------------------------------------
# 5) Headers de seguranca (equivalentes ao antigo vercel.json) + cache
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HTML nunca em cache (conteudo atualizado pelo CMS aparece na hora)
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Assets estaticos podem ser cacheados
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|woff2?|ttf|otf|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# 6) Tipos MIME (garante webp/fontes corretos em servidores antigos)
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType image/svg+xml               .svg
  AddType font/woff2                  .woff2
  AddType font/woff                   .woff
  AddType font/ttf                    .ttf
  AddType font/otf                    .otf
  AddType application/json            .json
</IfModule>

# --------------------------------------------------------------------------
# 7) Seguranca: desabilita listagem de diretorios
#    (NAO bloqueamos .yml/.json: o painel /admin carrega /admin/config.yml
#     no navegador — bloquea-los quebraria o CMS)
# --------------------------------------------------------------------------
Options -Indexes
